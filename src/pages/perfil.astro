---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Mi Perfil">
  <main class="relative min-h-screen pt-24 pb-20 px-4 sm:px-6 max-w-5xl mx-auto">
    <!-- Loading State -->
    <div id="loading-state" class="text-center py-20">
      <div class="inline-block w-8 h-8 border-2 border-white/20 border-t-white rounded-full animate-spin mb-4"></div>
      <p class="text-text-muted text-xs uppercase tracking-[0.2em]">Cargando perfil...</p>
    </div>

    <!-- Not Logged In State -->
    <div id="unauth-state" class="hidden text-center py-20 max-w-md mx-auto bg-surface/80 border border-white/10 p-8 backdrop-blur-xl">
      <div class="w-16 h-16 bg-white/5 border border-white/10 rounded-full flex items-center justify-center mx-auto mb-6">
        <svg class="w-8 h-8 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <rect x="3" y="4" width="18" height="16" rx="2" />
          <circle cx="9" cy="10" r="2.5" />
          <path d="M15 8h2M15 12h2M7 16h10" />
        </svg>
      </div>
      <h2 class="text-xl font-light uppercase tracking-[0.15em] text-text mb-3">Sesión no iniciada</h2>
      <p class="text-text-muted text-xs leading-relaxed mb-8">
        Por favor ingresa tu número de carnet de identidad para ver tu perfil de miembro y credencial digital.
      </p>
      <a
        href="/login"
        class="inline-block w-full bg-white text-bg px-6 py-3.5 uppercase text-xs tracking-[0.25em] font-medium hover:bg-white/90 transition-all"
      >
        Ir a Iniciar Sesión
      </a>
    </div>

    <!-- Logged In Profile Content -->
    <div id="profile-content" class="hidden space-y-8">
      <!-- Member Hero Banner Card -->
      <div class="bg-surface/90 border border-white/10 p-6 sm:p-8 backdrop-blur-xl relative overflow-hidden">
        <div class="absolute -right-10 -bottom-10 opacity-5 pointer-events-none">
          <img src="/images/logo_connect.svg" alt="" class="w-72 h-72" />
        </div>

        <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 relative z-10">
          <!-- Avatar -->
          <div class="relative">
            <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-full bg-surface-mid border-2 border-white/20 overflow-hidden flex items-center justify-center shadow-xl">
              <img id="user-photo" src="" alt="" class="w-full h-full object-cover hidden" />
              <span id="user-initial" class="text-3xl font-light text-text-muted"></span>
            </div>
            <span class="absolute bottom-1 right-1 w-4 h-4 bg-green-500 border-2 border-bg rounded-full" title="Socio Activo"></span>
          </div>

          <!-- Member Details Header -->
          <div class="text-center sm:text-left flex-1">
            <div class="flex flex-wrap items-center justify-center sm:justify-start gap-3 mb-2">
              <h1 id="user-name" class="text-2xl sm:text-3xl font-light tracking-[0.08em] text-text">--</h1>
              <span id="user-status" class="px-3 py-0.5 text-[10px] uppercase tracking-[0.2em] font-medium bg-green-500/10 text-green-400 border border-green-500/20">
                ACTIVO
              </span>
            </div>

            <p id="user-plan" class="text-accent text-xs uppercase tracking-[0.2em] font-medium mb-3">--</p>
            <p class="text-text-muted text-xs tracking-wider">Carnet: <span id="user-ci" class="text-text font-mono font-medium">--</span></p>
          </div>

          <!-- Actions -->
          <div class="flex flex-col sm:items-end gap-3 w-full sm:w-auto">
            <button
              id="qr-btn"
              class="px-5 py-2.5 bg-white text-bg hover:bg-white/90 uppercase text-[11px] tracking-[0.2em] font-medium transition-all flex items-center justify-center gap-2"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 013.75 9.375v-4.5zM3.75 14.625c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 01-1.125-1.125v-4.5zM13.5 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0113.5 9.375v-4.5z" />
              </svg>
              <span>Credencial QR</span>
            </button>
            <button
              id="logout-btn"
              class="px-5 py-2.5 bg-white/5 hover:bg-red-500/20 text-text-muted hover:text-red-400 border border-white/10 hover:border-red-500/30 uppercase text-[11px] tracking-[0.2em] font-medium transition-all"
            >
              Cerrar Sesión
            </button>
          </div>
        </div>
      </div>

      <!-- Stats Grid -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
        <!-- Stat 1 -->
        <div class="bg-surface/80 border border-white/5 p-5">
          <p class="text-text-muted text-[10px] uppercase tracking-[0.2em]">Días Restantes</p>
          <p id="user-days" class="text-2xl sm:text-3xl font-light text-text mt-2 mb-1">--</p>
          <p class="text-[11px] text-text-muted">Vence: <span id="user-expiration" class="text-text font-light">--</span></p>
        </div>

        <!-- Stat 2 -->
        <div class="bg-surface/80 border border-white/5 p-5">
          <p class="text-text-muted text-[10px] uppercase tracking-[0.2em]">Asistencias Mes</p>
          <p id="user-attendance" class="text-2xl sm:text-3xl font-light text-text mt-2 mb-1">--</p>
          <p class="text-[11px] text-text-muted">Racha: <span id="user-streak" class="text-text font-light">-- días</span></p>
        </div>

        <!-- Stat 3 -->
        <div class="bg-surface/80 border border-white/5 p-5">
          <p class="text-text-muted text-[10px] uppercase tracking-[0.2em]">Sucursal</p>
          <p id="user-branch" class="text-base sm:text-lg font-light text-text mt-2 truncate">--</p>
          <p class="text-[11px] text-text-muted">HQ Principal</p>
        </div>

        <!-- Stat 4 -->
        <div class="bg-surface/80 border border-white/5 p-5">
          <p class="text-text-muted text-[10px] uppercase tracking-[0.2em]">Entrenador</p>
          <p id="user-trainer" class="text-base sm:text-lg font-light text-text mt-2 truncate">--</p>
          <p class="text-[11px] text-text-muted">Entrenador de Turno</p>
        </div>
      </div>

      <!-- Detail Info Sections Grid -->
      <div class="grid md:grid-cols-2 gap-6">
        <!-- Account Info -->
        <div class="bg-surface/80 border border-white/10 p-6 sm:p-8 space-y-4">
          <h2 class="text-sm uppercase tracking-[0.2em] font-medium text-text border-b border-white/10 pb-4">
            Información Personal
          </h2>
          <div class="space-y-3 text-xs sm:text-sm">
            <div class="flex justify-between py-1 border-b border-white/5">
              <span class="text-text-muted">Correo Electrónico:</span>
              <span id="user-email" class="text-text font-light">--</span>
            </div>
            <div class="flex justify-between py-1 border-b border-white/5">
              <span class="text-text-muted">Teléfono:</span>
              <span id="user-phone" class="text-text font-light">--</span>
            </div>
            <div class="flex justify-between py-1 border-b border-white/5">
              <span class="text-text-muted">Fecha de Registro:</span>
              <span id="user-start" class="text-text font-light">--</span>
            </div>
            <div class="flex justify-between py-1">
              <span class="text-text-muted">Evaluación Física:</span>
              <span id="user-eval" class="text-green-400 font-light">--</span>
            </div>
          </div>
        </div>

        <!-- Quick Pass / QR Code Box (hidden, triggered by modal) -->

        <!-- QR Modal Overlay -->
        <div id="qr-modal" class="fixed inset-0 z-[100] flex items-center justify-center p-4 bg-black/90 backdrop-blur-md opacity-0 pointer-events-none transition-opacity duration-300">
          <div class="relative bg-[#121212] border border-white/15 shadow-2xl p-8 text-center max-w-sm w-full">
            <button id="qr-modal-close" class="absolute top-4 right-4 w-8 h-8 flex items-center justify-center text-text-muted hover:text-white bg-white/5 hover:bg-white/10 transition-colors">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
            <h2 class="text-sm uppercase tracking-[0.2em] font-medium text-text mb-6">Pase Rápido de Ingreso</h2>
            <div class="p-4 bg-white rounded-lg shadow-lg mb-4 inline-block">
              <svg class="w-44 h-44" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="100" height="100" fill="white" />
                <rect x="5" y="5" width="30" height="30" fill="black" />
                <rect x="10" y="10" width="20" height="20" fill="white" />
                <rect x="15" y="15" width="10" height="10" fill="black" />
                <rect x="65" y="5" width="30" height="30" fill="black" />
                <rect x="70" y="10" width="20" height="20" fill="white" />
                <rect x="75" y="15" width="10" height="10" fill="black" />
                <rect x="5" y="65" width="30" height="30" fill="black" />
                <rect x="10" y="70" width="20" height="20" fill="white" />
                <rect x="15" y="75" width="10" height="10" fill="black" />
                <rect x="40" y="10" width="10" height="10" fill="black" />
                <rect x="50" y="20" width="10" height="20" fill="black" />
                <rect x="40" y="40" width="20" height="20" fill="black" />
                <rect x="70" y="45" width="15" height="15" fill="black" />
                <rect x="45" y="70" width="15" height="20" fill="black" />
                <rect x="70" y="75" width="20" height="15" fill="black" />
              </svg>
            </div>
            <p class="text-text-muted text-[11px] uppercase tracking-widest mb-1">Escaneá en torniquetes de acceso</p>
            <p id="qr-user-label" class="text-accent text-xs font-medium"></p>
          </div>
        </div>

      </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  const loadingState = document.getElementById("loading-state") as HTMLDivElement;
  const unauthState = document.getElementById("unauth-state") as HTMLDivElement;
  const profileContent = document.getElementById("profile-content") as HTMLDivElement;
  const logoutBtn = document.getElementById("logout-btn") as HTMLButtonElement;

  // Read stored user
  const storedUserJson = localStorage.getItem("connect_user");

  if (!storedUserJson) {
    loadingState.classList.add("hidden");
    unauthState.classList.remove("hidden");
  } else {
    try {
      const user = JSON.parse(storedUserJson);

      // Auto update member 8337710 data if needed
      if (user.ci === "8337710" && (!user.plan || user.plan === "Pase Mensual Standard")) {
        user.plan = "PLAN CONNECT";
        user.fecha_caducacion = "2027-02-06T23:59:59.000Z";
        localStorage.setItem("connect_user", JSON.stringify(user));
      }

      renderProfile(user);
      loadingState.classList.add("hidden");
      profileContent.classList.remove("hidden");
    } catch {
      localStorage.removeItem("connect_user");
      loadingState.classList.add("hidden");
      unauthState.classList.remove("hidden");
    }
  }

  logoutBtn.addEventListener("click", () => {
    localStorage.removeItem("connect_user");
    window.location.href = "/login";
  });

  // QR Modal
  const qrModal = document.getElementById("qr-modal");
  const qrModalClose = document.getElementById("qr-modal-close");
  const qrBtn = document.getElementById("qr-btn");
  const qrUserLabel = document.getElementById("qr-user-label");

  qrBtn?.addEventListener("click", () => {
    if (qrModal) {
      qrModal.classList.remove("opacity-0", "pointer-events-none");
      if (qrUserLabel) {
        const u = JSON.parse(localStorage.getItem("connect_user") || "{}");
        qrUserLabel.textContent = `${u.nombre || "Socio"} — CI: ${u.ci || "--"}`;
      }
    }
  });

  qrModalClose?.addEventListener("click", () => {
    qrModal?.classList.add("opacity-0", "pointer-events-none");
  });

  qrModal?.addEventListener("click", (e) => {
    if (e.target === qrModal) qrModal.classList.add("opacity-0", "pointer-events-none");
  });

  function renderProfile(user: any) {
    const $ = (id: string) => document.getElementById(id);

    $("user-name")!.textContent = user.nombre || "Socio";
    $("user-plan")!.textContent = user.plan || "Plan Standard";
    $("user-ci")!.textContent = user.ci || "--";

    // Photo / Initials
    const photoEl = document.getElementById("user-photo") as HTMLImageElement;
    const initialEl = document.getElementById("user-initial") as HTMLSpanElement;

    if (user.foto) {
      photoEl.src = user.foto;
      photoEl.classList.remove("hidden");
      initialEl.classList.add("hidden");
    } else {
      initialEl.textContent = (user.nombre || "S").charAt(0);
      initialEl.classList.remove("hidden");
      photoEl.classList.add("hidden");
    }

    // Expiration and Days Left
    const expDate = new Date(user.fecha_caducacion || Date.now());
    const diasRestantes = Math.ceil((expDate.getTime() - Date.now()) / (1000 * 60 * 60 * 24));
    const activo = diasRestantes > 0;

    const fechaFormateada = expDate.toLocaleDateString("es-BO", {
      day: "numeric",
      month: "short",
      year: "numeric",
    });

    document.getElementById("user-days")!.textContent = diasRestantes > 0 ? `${diasRestantes}` : "0";
    document.getElementById("user-expiration")!.textContent = fechaFormateada;

    const statusEl = document.getElementById("user-status")!;
    if (activo) {
      statusEl.textContent = "ACTIVO";
      statusEl.className = "px-3 py-0.5 text-[10px] uppercase tracking-[0.2em] font-medium bg-green-500/10 text-green-400 border border-green-500/20";
    } else {
      statusEl.textContent = "VENCIDO";
      statusEl.className = "px-3 py-0.5 text-[10px] uppercase tracking-[0.2em] font-medium bg-red-500/10 text-red-400 border border-red-500/20";
    }

    $("user-attendance")!.textContent = `${user.asistencias_mes || 0}`;
    $("user-streak")!.textContent = `${user.racha_dias || 0} días`;
    $("user-branch")!.textContent = user.sucursal || "Connect Sur";
    $("user-trainer")!.textContent = user.entrenador || "Staff Connect";
    $("user-email")!.textContent = user.email || "No registrado";
    $("user-phone")!.textContent = user.telefono || "No registrado";
    $("user-start")!.textContent = user.fecha_inicio || "--";
    $("user-eval")!.textContent = user.evaluacion_fisica || "Apto";
  }
</script>
