---
import Layout from "../layouts/Layout.astro";

// DATOS REEMPLAZABLES POR LOS DATOS REALES DEL USUARIO:
export const eventosData = [
  {
    id: 1,
    badge: "Inscripciones Abiertas",
    titulo: "Desafío de Verano 2026",
    fecha: "Inicio: 1 de Septiembre",
    lugar: "Connect Headquarters - Sur",
    descripcion:
      "8 semanas de entrenamiento intensivo, seguimiento nutricional y evaluación de composición corporal.",
    destacado: true,
  },
  {
    id: 2,
    badge: "Evento Especial",
    titulo: "Masterclass de Indoor Cycling",
    fecha: "Sábado 25 de Agosto | 10:00 AM",
    lugar: "Sala de Spinning",
    descripcion:
      "90 minutos de ritmo continuo con instructores invitados y show de luces en vivo.",
    destacado: false,
  },
  {
    id: 3,
    badge: "Promoción Activa",
    titulo: "Plan Dúo / Parejas",
    fecha: "Válido todo el mes",
    lugar: "Todas las sucursales",
    descripcion:
      "Inscríbete con un acompañante y obtén un 20% de descuento en la membresía trimestral o semestral.",
    destacado: false,
  },
];
---

<Layout title="Eventos & Promociones">
  <div
    class="relative min-h-screen pt-28 pb-24 px-4 sm:px-6 max-w-6xl mx-auto"
  >
    <!-- Header Banner -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-accent text-xs tracking-[0.3em] uppercase font-medium"
        >Novedades &amp; Comunidad</span
      >
      <h1
        class="text-4xl sm:text-5xl font-light tracking-[0.15em] uppercase text-text mt-3 mb-6"
      >
        Eventos &amp; Promociones
      </h1>
      <div class="h-px w-20 bg-surface-mid mx-auto mb-6"></div>
      <p
        class="text-text-muted text-sm sm:text-base font-light leading-relaxed"
      >
        Descubre nuestros próximos talleres, competencias, actividades
        especiales y promociones exclusivas para socios.
      </p>
    </div>

    <!-- Events List / Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        eventosData.map((evento) => (
          <div
            class={`bg-surface/90 border p-8 backdrop-blur-xl flex flex-col justify-between transition-all duration-300 hover:border-white/30 ${
              evento.destacado
                ? "border-accent/40 bg-surface-light/40"
                : "border-white/10"
            }`}
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-4">
                <span class="px-3 py-1 text-[10px] uppercase tracking-[0.2em] font-medium bg-white/10 text-accent border border-white/15">
                  {evento.badge}
                </span>
                {evento.destacado && (
                  <span class="text-[10px] uppercase tracking-widest text-amber-400 font-medium">
                    ★ Destacado
                  </span>
                )}
              </div>

              <h2 class="text-xl font-light tracking-[0.08em] text-text mb-3">
                {evento.titulo}
              </h2>
              <p class="text-text-muted text-xs font-light leading-relaxed mb-6">
                {evento.descripcion}
              </p>
            </div>

            <div class="space-y-4 pt-4 border-t border-white/10">
              <div class="space-y-1 text-xs">
                <p class="text-text font-medium tracking-wide flex items-center gap-2">
                  <svg
                    class="w-3.5 h-3.5 text-accent"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"
                    />
                  </svg>
                  <span>{evento.fecha}</span>
                </p>
                <p class="text-text-muted text-[11px] flex items-center gap-2">
                  <svg
                    class="w-3.5 h-3.5 text-text-muted"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"
                    />
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"
                    />
                  </svg>
                  <span>{evento.lugar}</span>
                </p>
              </div>

              <a
                href="/login"
                class="block w-full text-center bg-white/5 hover:bg-white text-text hover:text-bg border border-white/20 px-4 py-3 uppercase text-[11px] tracking-[0.2em] font-medium transition-all duration-300"
              >
                Consultar / Inscribirme
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</Layout>
