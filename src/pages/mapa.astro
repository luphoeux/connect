---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Mapa">
  <main class="pt-16 sm:pt-20">
    <div class="max-w-7xl mx-auto px-0 pb-0">
      <iframe
        src="https://pacha-luphoe.vercel.app/maps/gimnasio-connect?v=20260818"
        width="100%"
        height="100%"
        style="border:0; min-height: calc(100vh - 200px);"
        allowfullscreen=""
        loading="lazy"
        class="w-full"
        title="Mapa Interactivo"
      ></iframe>
    </div>
  </main>
</Layout>
