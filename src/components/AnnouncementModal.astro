---
import { NOTIFICACIONES } from "../lib/notificaciones";
---

<!-- Announcement Modal Backdrop -->
<div
  id="announcement-modal"
  class="fixed inset-0 z-[100] flex items-center justify-center p-4 bg-black/85 backdrop-blur-md transition-opacity duration-300 opacity-0 pointer-events-none"
  role="alertdialog"
  aria-modal="true"
  aria-labelledby="announcement-modal-title"
  aria-describedby="announcement-modal-desc"
>
  <!-- Modal Card -->
  <div
    class="relative w-full max-w-lg bg-bg border border-white/15 shadow-2xl p-6 sm:p-8 text-center text-text overflow-hidden transition-transform duration-300 scale-95"
    id="modal-card"
  >
    <!-- Close Button X -->
    <button
      id="close-modal-btn"
      class="absolute top-4 right-4 z-20 w-8 h-8 flex items-center justify-center text-text-muted hover:text-white bg-white/5 hover:bg-white/10 transition-colors focus:outline-none focus:ring-2 focus:ring-accent"
      aria-label="Cerrar aviso"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Header Logo Symbol -->
    <div class="mb-4">
      <img src="/images/logo_connect.svg" alt="Connect" class="h-8 w-auto mx-auto opacity-90" />
    </div>

    <!-- Carousel Container -->
    <div class="relative min-h-[320px] flex flex-col justify-between">
      {NOTIFICACIONES.map((anuncio, idx) => (
        <div
          class={`announcement-slide ${idx === 0 ? "block" : "hidden"} transition-all duration-300`}
          data-index={idx}
          data-id={anuncio.id}
        >
          <!-- Badge / Tag -->
          <span class="inline-block px-3 py-1 bg-amber-500/10 text-amber-400 border border-amber-500/20 text-[10px] uppercase tracking-[0.25em] font-medium mb-3">
            Aviso Importante
          </span>

          <h2 id="announcement-modal-title" class="text-2xl sm:text-3xl font-light tracking-[0.2em] uppercase text-text mb-1">
            {anuncio.titulo}
          </h2>
          <p class="text-accent text-xs sm:text-sm tracking-[0.3em] font-medium mb-8">
            {anuncio.subtitulo}
          </p>

          <!-- Classes Grid/List -->
          <div class={`grid gap-4 my-6 ${anuncio.clases.length === 3 ? "grid-cols-3" : anuncio.clases.length === 2 ? "grid-cols-2" : "grid-cols-1"}`}>
            {anuncio.clases.map((c) => (
              <div class="border-x first:border-l-0 last:border-r-0 border-white/10 px-2 py-2">
                <p class="text-xs sm:text-sm font-medium tracking-wider text-text uppercase">{c.disciplina}</p>
                <p class="text-xl sm:text-2xl font-light font-mono text-text mt-1">{c.hora}</p>
                <p class="text-[10px] uppercase tracking-[0.2em] text-accent mt-1">{c.dia}</p>
              </div>
            ))}
          </div>

          <p class="text-[10px] uppercase tracking-[0.3em] text-text-muted font-light mt-8">
            {anuncio.footer}
          </p>
        </div>
      ))}

      <!-- Carousel Navigation Controls -->
      {NOTIFICACIONES.length > 1 && (
        <div class="flex items-center justify-between mt-6 pt-4 border-t border-white/10">
          <button
            id="prev-slide-btn"
            class="px-3 py-1.5 bg-white/5 hover:bg-white/10 text-text-muted hover:text-white text-xs uppercase tracking-wider transition-colors flex items-center gap-1 focus:outline-none focus:ring-2 focus:ring-accent"
          >
            ‹ Anterior
          </button>

          <!-- Dots Indicator -->
          <div class="flex items-center gap-2">
            {NOTIFICACIONES.map((_, idx) => (
              <button
                class={`dot-btn w-2 h-2 rounded-full transition-all ${idx === 0 ? "bg-white w-4" : "bg-white/30"}`}
                data-target={idx}
                aria-label={`Ir al aviso ${idx + 1}`}
              />
            ))}
          </div>

          <button
            id="next-slide-btn"
            class="px-3 py-1.5 bg-white/5 hover:bg-white/10 text-text-muted hover:text-white text-xs uppercase tracking-wider transition-colors flex items-center gap-1 focus:outline-none focus:ring-2 focus:ring-accent"
          >
            Siguiente ›
          </button>
        </div>
      )}
    </div>

    <p id="announcement-modal-desc" class="sr-only">
      Aviso importante de Connect Health &amp; Fitness. Puedes navegar entre avisos y cerrar el cuadro de diálogo.
    </p>

    <!-- Confirm / Close CTA Button -->
    <div class="mt-6">
      <button
        id="confirm-modal-btn"
        class="w-full py-3 bg-white text-bg uppercase text-xs tracking-[0.25em] font-medium hover:bg-white/90 transition-all focus:outline-none focus:ring-2 focus:ring-accent"
      >
        Entendido
      </button>
    </div>
  </div>
</div>

<script is:inline define:vars={{ NOTIFICACIONES }}>
  const modal = document.getElementById("announcement-modal");
  const modalCard = document.getElementById("modal-card");
  const closeBtn = document.getElementById("close-modal-btn");
  const confirmBtn = document.getElementById("confirm-modal-btn");

  const slides = document.querySelectorAll(".announcement-slide");
  const dots = document.querySelectorAll(".dot-btn");
  const prevBtn = document.getElementById("prev-slide-btn");
  const nextBtn = document.getElementById("next-slide-btn");

  let currentSlide = 0;
  let lastFocused = null;

  const READ_KEY = "read_notifs";
  const CLOSED_KEY = "announcement_closed_";

  function getReadNotifs() {
    try {
      return JSON.parse(localStorage.getItem(READ_KEY) || "[]");
    } catch {
      return [];
    }
  }

  function isClosedForSession(id) {
    try {
      return sessionStorage.getItem(CLOSED_KEY + id) === "true";
    } catch {
      return false;
    }
  }

  function markClosedForSession(id) {
    try {
      sessionStorage.setItem(CLOSED_KEY + id, "true");
    } catch {}
  }

  function markCurrentAsRead() {
    const currentSlideEl = slides[currentSlide];
    if (!currentSlideEl) return;
    const id = currentSlideEl.getAttribute("data-id");
    if (!id) return;

    const readNotifs = getReadNotifs();
    if (!readNotifs.includes(id)) {
      readNotifs.push(id);
      localStorage.setItem(READ_KEY, JSON.stringify(readNotifs));
      window.dispatchEvent(new Event("notifs-updated"));
    }
  }

  function showSlide(index) {
    if (slides.length === 0) return;
    currentSlide = (index + slides.length) % slides.length;

    slides.forEach((slide, idx) => {
      if (idx === currentSlide) {
        slide.classList.remove("hidden");
        slide.classList.add("block");
      } else {
        slide.classList.remove("block");
        slide.classList.add("hidden");
      }
    });

    dots.forEach((dot, idx) => {
      if (idx === currentSlide) {
        dot.className = "dot-btn w-4 h-2 bg-white rounded-full transition-all";
      } else {
        dot.className = "dot-btn w-2 h-2 bg-white/30 rounded-full transition-all";
      }
    });

    markCurrentAsRead();
  }

  function openModal(targetIndex = 0) {
    showSlide(targetIndex);
    lastFocused = document.activeElement;
    modal.classList.remove("opacity-0", "pointer-events-none");
    modalCard.classList.remove("scale-95");
    modalCard.classList.add("scale-100");
    document.body.style.overflow = "hidden";
    closeBtn?.focus();
  }

  function closeModal() {
    markCurrentAsRead();
    modal.classList.add("opacity-0", "pointer-events-none");
    modalCard.classList.remove("scale-100");
    modalCard.classList.add("scale-95");
    document.body.style.overflow = "";
    lastFocused?.focus();
  }

  function getUnseenIndex() {
    const readNotifs = getReadNotifs();
    const idx = NOTIFICACIONES.findIndex((n) => !readNotifs.includes(n.id));
    return idx >= 0 ? idx : 0;
  }

  // Auto-open on home page only, if there are unread announcements for this session
  if (window.location.pathname === "/") {
    const hasUnseen = NOTIFICACIONES.some((n) => !getReadNotifs().includes(n.id));
    const anyOpenThisSession = NOTIFICACIONES.some((n) => isClosedForSession(n.id));
    if (hasUnseen && !anyOpenThisSession) {
      setTimeout(() => openModal(getUnseenIndex()), 600);
    }
  }

  // Listen to custom event from Header notifications dropdown
  window.addEventListener("open-announcement-modal", (e) => {
    const targetIndex = e.detail?.index ?? 0;
    openModal(targetIndex);
  });

  closeBtn?.addEventListener("click", () => {
    markClosedForSession(slides[currentSlide]?.getAttribute("data-id") || "");
    closeModal();
  });

  confirmBtn?.addEventListener("click", () => {
    markClosedForSession(slides[currentSlide]?.getAttribute("data-id") || "");
    closeModal();
  });

  modal?.addEventListener("click", (e) => {
    if (e.target === modal) {
      markClosedForSession(slides[currentSlide]?.getAttribute("data-id") || "");
      closeModal();
    }
  });

  // Close with Escape
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !modal.classList.contains("opacity-0")) {
      markClosedForSession(slides[currentSlide]?.getAttribute("data-id") || "");
      closeModal();
    }
  });

  // Focus trap: keep focus inside the dialog while open
  modal?.addEventListener("keydown", (e) => {
    if (e.key !== "Tab" || modal.classList.contains("opacity-0")) return;
    const focusable = Array.from(
      modal.querySelectorAll(
        'button:not([disabled]), [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
      )
    ).filter((el) => el.offsetParent !== null);

    if (focusable.length === 0) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];

    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });

  prevBtn?.addEventListener("click", () => showSlide(currentSlide - 1));
  nextBtn?.addEventListener("click", () => showSlide(currentSlide + 1));

  dots.forEach((dot) => {
    dot.addEventListener("click", () => {
      const targetIndex = parseInt(dot.getAttribute("data-target") || "0", 10);
      showSlide(targetIndex);
    });
  });
</script>