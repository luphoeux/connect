---
// Componente de Footer Adaptativo (Completo para visitas públicas, Exclusivamente copyright para socios)
---

<!-- Member Minimal Footer View (Shown when logged in) -->
<footer id="member-footer" class="hidden border-t border-white/10 bg-bg/95 text-center py-8 pb-24 sm:pb-8 px-4">
  <div class="max-w-7xl mx-auto space-y-2">
    <p class="uppercase tracking-[0.2em] text-xs font-medium text-text-muted">
      Connect Health &amp; Fitness &copy; {new Date().getFullYear()}
    </p>
    <p class="text-[11px] text-text-muted/70 font-light">
      San Miguel • Mall Plaza 21, Piso 3 • La Paz, Bolivia
    </p>
  </div>
</footer>

<!-- Public Full Footer View (Shown for guest / unauthenticated visitors) -->
<footer id="main-footer" class="bg-surface/95 border-t border-white/10 text-text pt-16 pb-12 sm:pb-16 px-4 sm:px-6 relative overflow-hidden">
  <div class="max-w-7xl mx-auto space-y-12">
    <!-- Top Grid: Brand & Contact Info + Google Maps Embed -->
    <div class="grid lg:grid-cols-12 gap-10 items-start">
      
      <!-- Brand & Fast Info (5 Cols) -->
      <div class="lg:col-span-5 space-y-6">
        <a href="/" class="inline-block group focus:outline-none">
          <img
            src="/images/logo_connect_letras.svg"
            alt="Connect Health & Fitness"
            class="h-9 w-auto object-contain transition-opacity group-hover:opacity-80"
          />
        </a>

        <p class="text-text-muted text-xs sm:text-sm font-light leading-relaxed max-w-md">
          Entrena con nosotros. Conéctate contigo mismo. Centro de entrenamiento premium en la Zona Sur de La Paz.
        </p>

        <!-- Location Cards Grid -->
        <div class="space-y-4 pt-2">
          <div class="flex items-start gap-3.5 bg-bg/60 border border-white/10 p-4">
            <div class="w-8 h-8 rounded-full bg-accent/10 border border-accent/30 flex items-center justify-center text-accent flex-shrink-0 mt-0.5">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
              </svg>
            </div>
            <div>
              <span class="text-[10px] uppercase tracking-wider text-text-muted font-medium block">Ubicación HQ</span>
              <p class="text-xs sm:text-sm font-medium text-text mt-0.5">Mall Plaza 21, Piso 3</p>
              <p class="text-xs text-text-muted font-light">San Miguel, La Paz - Bolivia</p>
            </div>
          </div>

          <div class="flex items-start gap-3.5 bg-bg/60 border border-white/10 p-4">
            <div class="w-8 h-8 rounded-full bg-accent/10 border border-accent/30 flex items-center justify-center text-accent flex-shrink-0 mt-0.5">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <span class="text-[10px] uppercase tracking-wider text-text-muted font-medium block">Horarios de Atención</span>
              <p class="text-xs sm:text-sm font-medium text-text mt-0.5">Lun a Vie: 06:00 - 23:00</p>
              <p class="text-xs text-text-muted font-light">Sáb: 08:00 - 20:00 | Dom/Feriados: 09:00 - 15:00</p>
            </div>
          </div>
        </div>

        <!-- Social Media & WhatsApp CTAs -->
        <div class="pt-2 space-y-3">
          <div class="flex flex-wrap items-center gap-3">
            <a
              href="https://www.facebook.com/profile.php?id=100076283411100"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2.5 px-4 py-2.5 bg-blue-600/15 hover:bg-blue-600 text-white border border-blue-500/30 uppercase text-xs tracking-wider font-medium transition-all duration-300 shadow-md group"
              title="Facebook Connect Health & Fitness"
            >
              <svg class="w-4 h-4 text-blue-400 group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
              <span>Facebook</span>
            </a>

            <a
              href="https://www.instagram.com/connect.bo/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2.5 px-4 py-2.5 bg-pink-600/15 hover:bg-pink-600 text-white border border-pink-500/30 uppercase text-xs tracking-wider font-medium transition-all duration-300 shadow-md group"
              title="Instagram Connect Health & Fitness"
            >
              <svg class="w-4 h-4 text-pink-400 group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
              <span>Instagram</span>
            </a>
          </div>

          <a
            href="https://wa.me/59177254022"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 px-6 py-3.5 bg-emerald-600/20 hover:bg-emerald-600 text-white border border-emerald-500/40 uppercase text-xs tracking-[0.2em] font-medium transition-all duration-300 shadow-xl w-full sm:w-auto justify-center"
          >
            <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338-11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
            </svg>
            <span>WhatsApp (+591 77 25 40 22)</span>
          </a>
        </div>
      </div>

      <!-- Google Maps Embed Container (7 Cols) -->
      <div class="lg:col-span-7 bg-bg/80 border border-white/15 p-2 shadow-2xl relative">
        <div class="flex items-center justify-between px-4 py-2.5 bg-surface border-b border-white/10 mb-2">
          <span class="text-xs uppercase tracking-[0.2em] font-medium text-text flex items-center gap-2">
            <svg class="w-4 h-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
            <span>Mapa &amp; Cómo Llegar</span>
          </span>
          <a
            href="https://maps.google.com/?q=Mall+Plaza+21+San+Miguel+La+Paz+Bolivia"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[10px] uppercase tracking-wider text-accent hover:underline font-medium"
          >
            Abrir en Google Maps ↗
          </a>
        </div>

        <!-- Google Maps Iframe -->
        <div class="w-full h-[280px] sm:h-[340px] bg-bg overflow-hidden relative">
          <iframe
            src="https://maps.google.com/maps?q=Mall+Plaza+21,+Calle+21,+San+Miguel,+La+Paz,+Bolivia&t=&z=17&ie=UTF8&iwloc=&output=embed"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="w-full h-full grayscale opacity-90 contrast-125 hover:grayscale-0 transition-all duration-500"
            title="Ubicación Connect Health & Fitness - Mall Plaza 21"
          ></iframe>
        </div>
      </div>
    </div>

    <!-- Bottom Copyright Line -->
    <div class="pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-text-muted font-light">
      <p class="uppercase tracking-[0.2em]">
        Connect Health &amp; Fitness &copy; {new Date().getFullYear()}
      </p>
      <p class="text-[11px]">
        San Miguel • Mall Plaza 21, Piso 3 • La Paz, Bolivia
      </p>
    </div>
  </div>
</footer>

<script>
  function updateFooterView() {
    const userJson = localStorage.getItem("connect_user");
    const mainFooter = document.getElementById("main-footer");
    const memberFooter = document.getElementById("member-footer");

    if (userJson) {
      mainFooter?.classList.add("hidden");
      memberFooter?.classList.remove("hidden");
    } else {
      mainFooter?.classList.remove("hidden");
      memberFooter?.classList.add("hidden");
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", updateFooterView);
  } else {
    updateFooterView();
  }
</script>
