---
import { NOTIFICACIONES } from "../lib/notificaciones";
---

<!-- Top Header Navigation -->
<header
  id="main-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 bg-transparent border-b border-transparent backdrop-blur-none shadow-none"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 sm:h-18 md:h-20 flex md:grid md:grid-cols-[auto_1fr_auto] items-center justify-between gap-4">
    <!-- Brand Logo (Left) -->
    <a href="/#inicio" class="flex items-center justify-start gap-2 sm:gap-3 group focus:outline-none min-w-[80px] sm:min-w-[150px]">
      <img
        id="header-logo"
        src="/images/logo_connect.svg"
        alt="Connect Health & Fitness"
        class="h-6 sm:h-8 md:h-9 w-auto max-w-[100px] sm:max-w-[150px] md:max-w-[160px] object-contain transition-opacity duration-200 group-hover:opacity-80"
        data-state="symbol"
      />
    </a>

    <!-- Desktop Navigation Links - Guest Public View -->
    <nav id="header-guest-nav" class="hidden md:flex items-center gap-6 lg:gap-8 justify-center">
      <a
        href="/#inicio"
        class="text-xs uppercase tracking-[0.2em] font-medium text-text-muted hover:text-text transition-colors whitespace-nowrap"
      >
        Inicio
      </a>
      <a
        href="/#horarios"
        class="text-xs uppercase tracking-[0.2em] font-medium text-text-muted hover:text-text transition-colors whitespace-nowrap"
      >
        Horarios
      </a>
      <a
        href="/#galeria"
        class="text-xs uppercase tracking-[0.2em] font-medium text-text-muted hover:text-text transition-colors whitespace-nowrap"
      >
        Galería
      </a>
      <a
        href="/#pet-friendly"
        class="text-xs uppercase tracking-[0.2em] font-medium text-text-muted hover:text-text transition-colors whitespace-nowrap"
      >
        Pet Friendly
      </a>
      <a
        href="/#eventos"
        class="text-xs uppercase tracking-[0.2em] font-medium text-text-muted hover:text-text transition-colors whitespace-nowrap"
      >
        Eventos
      </a>
      <a
        href="/#mapa"
        class="text-xs uppercase tracking-[0.2em] font-medium text-text-muted hover:text-text transition-colors whitespace-nowrap"
      >
        Mapa
      </a>
      <a
        href="/#contacto"
        class="text-xs uppercase tracking-[0.2em] font-medium text-text-muted hover:text-text transition-colors whitespace-nowrap"
      >
        Contacto
      </a>
    </nav>

    <!-- Desktop Navigation Links - Logged-In Member View (Hidden on mobile < md, visible on desktop md:flex) -->
    <nav id="header-member-nav" class="hidden md:flex items-center gap-6 lg:gap-8 justify-center">
      <a
        href="/"
        data-member-path="/"
        class="header-member-link text-xs uppercase tracking-[0.2em] font-medium text-text-muted hover:text-text transition-colors whitespace-nowrap"
      >
        Inicio
      </a>
      <a
        href="/horarios"
        data-member-path="/horarios"
        class="header-member-link text-xs uppercase tracking-[0.2em] font-medium text-text-muted hover:text-text transition-colors whitespace-nowrap"
      >
        Horarios &amp; Eventos
      </a>
      <a
        href="/perfil"
        data-member-path="/perfil"
        class="header-member-link text-xs uppercase tracking-[0.2em] font-medium text-text-muted hover:text-text transition-colors whitespace-nowrap"
      >
        Mi Perfil
      </a>
    </nav>

    <!-- Header Action Area (Right) -->
    <div class="flex items-center justify-end gap-2.5 sm:gap-3">
      <!-- Notification Bell Icon & History Dropdown -->
      <div class="relative">
        <button
          id="notif-bell-btn"
          class="relative h-9 sm:h-10 w-9 sm:w-10 flex items-center justify-center bg-surface/90 hover:bg-white/10 border border-white/20 text-text transition-all focus:outline-none group"
          aria-label="Notificaciones y Avisos"
        >
          <svg class="w-4 sm:w-5 h-4 sm:h-5 text-text-muted group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0018 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 00-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" />
          </svg>
          <!-- Unread Red Badge Count -->
          <span
            id="notif-badge"
            class="absolute -top-1 -right-1 min-w-[18px] h-[18px] px-1 bg-red-500 text-white text-[10px] font-bold rounded-full flex items-center justify-center hidden shadow-md animate-pulse"
          >
            0
          </span>
        </button>

        <!-- Notifications History Dropdown Panel -->
        <div
          id="notif-dropdown"
          class="fixed sm:absolute inset-x-3 sm:inset-x-auto right-auto sm:right-0 top-16 sm:top-full sm:mt-2 w-auto sm:w-96 bg-surface/95 border border-white/15 shadow-2xl p-4 z-50 hidden backdrop-blur-xl transition-all"
        >
          <div class="flex items-center justify-between pb-3 border-b border-white/10 mb-3">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-accent"></span>
              <h3 class="text-xs uppercase tracking-[0.2em] font-medium text-text">Avisos &amp; Comunicados</h3>
            </div>
            <span class="text-[10px] text-text-muted uppercase tracking-wider">Historial 2 meses</span>
          </div>

          <!-- Notification Items List -->
          <div id="notif-list" class="space-y-2 max-h-72 overflow-y-auto pr-1">
            {NOTIFICACIONES.map((item, idx) => (
              <button
                class="notif-item-btn w-full p-3 text-left bg-white/5 hover:bg-white/10 border border-white/10 transition-all group flex items-start gap-3"
                data-id={item.id}
                data-index={idx}
              >
                <span class="notif-dot w-2 h-2 rounded-full bg-accent mt-1.5 flex-shrink-0"></span>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center justify-between gap-2 mb-1">
                    <p class="text-xs font-medium uppercase tracking-wider text-text truncate group-hover:text-accent transition-colors">{item.titulo}</p>
                    <span class="text-[9px] text-text-muted uppercase flex-shrink-0">{item.fechaFormateada}</span>
                  </div>
                  <p class="text-[11px] text-text-secondary font-light leading-snug line-clamp-2">{item.resumen}</p>
                </div>
              </button>
            ))}
          </div>

          <div class="pt-3 border-t border-white/10 mt-3 flex items-center justify-between text-[10px] text-text-muted">
            <span>Toca un aviso para reabrir el popup</span>
            <button id="mark-all-read-btn" class="text-accent hover:underline uppercase tracking-wider font-medium">
              Marcar leídos
            </button>
          </div>
        </div>
      </div>
      <!-- Guest State Button (Collapses to 0 width in Hero so notification bell sits far right, expands smoothly on scroll) -->
      <a
        id="header-guest-btn"
        href="/login"
        class="inline-flex items-center gap-1.5 h-9 sm:h-10 bg-white/10 hover:bg-white text-text hover:text-bg text-[10px] sm:text-xs uppercase tracking-[0.15em] font-medium transition-all duration-500 max-w-0 opacity-0 pointer-events-none overflow-hidden border-0 px-0 flex-shrink-0 group whitespace-nowrap"
      >
        <svg
          class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-text group-hover:text-bg transition-colors flex-shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <rect x="3" y="4" width="18" height="16" rx="2" />
          <circle cx="9" cy="10" r="2.5" />
          <path d="M15 8h2M15 12h2M7 16h10" />
        </svg>
        <span>Ingresar</span>
      </a>

      <!-- Logged In User Dropdown Container (Shown when logged in) -->
      <div id="header-user-container" class="relative hidden">
        <button
          id="header-user-menu-btn"
          class="flex items-center gap-2 sm:gap-2.5 h-9 sm:h-10 px-2.5 sm:px-3.5 bg-surface/90 hover:bg-white/10 border border-white/20 transition-all focus:outline-none group"
          aria-expanded="false"
        >
          <!-- User Avatar -->
          <div class="w-6 h-6 sm:w-7 sm:h-7 rounded-full bg-surface-mid border border-white/20 overflow-hidden flex items-center justify-center flex-shrink-0">
            <img id="header-user-photo" src="" alt="" class="w-full h-full object-cover hidden" />
            <span id="header-user-initial" class="text-[11px] sm:text-xs font-semibold text-text"></span>
          </div>

          <!-- User Info Text -->
          <div class="text-left hidden sm:block">
            <p id="header-user-name" class="text-xs font-medium text-text tracking-wide leading-tight truncate max-w-[90px]">--</p>
            <p id="header-user-plan" class="text-[9px] text-accent tracking-wider font-light truncate max-w-[90px]">--</p>
          </div>

          <!-- Chevron -->
          <svg class="w-3.5 h-3.5 text-text-muted group-hover:text-white transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
          </svg>
        </button>

        <!-- Dropdown Menu Box -->
        <div
          id="header-user-dropdown"
          class="absolute right-0 mt-2 w-56 bg-surface/95 border border-white/15 shadow-2xl p-2 z-50 hidden backdrop-blur-xl transition-all"
        >
          <div class="px-3 py-2 border-b border-white/10 mb-1">
            <p id="header-dropdown-name" class="text-xs font-medium text-text truncate">--</p>
            <p id="header-dropdown-plan" class="text-[10px] text-accent font-light truncate">--</p>
          </div>

          <a
            href="/perfil"
            class="flex items-center gap-2.5 px-3 py-2 text-xs uppercase tracking-wider text-text hover:bg-white/10 transition-colors"
          >
            <svg class="w-4 h-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <rect x="3" y="4" width="18" height="16" rx="2" />
              <circle cx="9" cy="10" r="2.5" />
              <path d="M15 8h2M15 12h2M7 16h10" />
            </svg>
            <span>Mi Perfil &amp; Credencial</span>
          </a>

          <button
            id="header-logout-btn"
            class="w-full flex items-center gap-2.5 px-3 py-2 text-xs uppercase tracking-wider text-red-400 hover:bg-red-500/10 transition-colors text-left font-medium"
          >
            <svg class="w-4 h-4 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12" />
            </svg>
            <span>Cerrar Sesión</span>
          </button>
        </div>
      </div>
      <!-- Mobile Hamburger Button (Visible on mobile < md) -->
      <button
        id="mobile-hamburger-btn"
        type="button"
        class="md:hidden h-9 w-9 flex items-center justify-center bg-surface/90 hover:bg-white/10 border border-white/20 text-text transition-all focus:outline-none"
        aria-label="Abrir menú de navegación"
      >
        <svg class="w-5 h-5 text-text" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Bottom Navigation (Web App Footer Menu - Visible only when logged in) -->
<nav
  id="mobile-bottom-nav"
  aria-label="Menú principal móvil"
  class="fixed bottom-0 left-0 right-0 z-50 md:hidden backdrop-blur-xl bg-bg/95 border-t border-white/10 px-2 py-2 safe-area-pb hidden"
>
  <div class="grid grid-cols-3 items-center max-w-md mx-auto">
    <!-- Inicio -->
    <a
      href="/"
      class="mobile-nav-item flex flex-col items-center justify-center py-1 text-text-muted hover:text-white transition-all duration-200"
      data-path="/"
    >
      <svg class="w-5 h-5 mb-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
      </svg>
      <span class="text-[10px] uppercase tracking-wider font-light">Inicio</span>
    </a>

    <!-- Horarios y Eventos -->
    <a
      href="/horarios"
      class="mobile-nav-item flex flex-col items-center justify-center py-1 text-text-muted hover:text-white transition-all duration-200"
      data-path="/horarios"
    >
      <svg class="w-5 h-5 mb-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span class="text-[10px] uppercase tracking-wider font-light">Actividad</span>
    </a>

    <!-- Mi perfil / Cuenta -->
    <a
      href="/perfil"
      class="mobile-nav-item flex flex-col items-center justify-center py-1 text-text-muted hover:text-white transition-all duration-200"
      data-path="/perfil"
    >
      <svg class="w-5 h-5 mb-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <rect x="3" y="4" width="18" height="16" rx="2" />
        <circle cx="9" cy="10" r="2.5" />
        <path d="M15 8h2M15 12h2M7 16h10" />
      </svg>
      <span class="text-[10px] uppercase tracking-wider font-light">Mi perfil</span>
    </a>
  </div>
</nav>

<!-- Mobile Slide-Over Hamburger Navigation Overlay -->
<div
  id="mobile-hamburger-drawer"
  class="fixed inset-0 z-[100] bg-black/90 backdrop-blur-2xl md:hidden hidden flex-col transition-all duration-300"
>
  <!-- Top Bar inside Drawer -->
  <div class="flex items-center justify-between p-4 sm:p-6 border-b border-white/10">
    <div class="flex items-center gap-3">
      <img src="/images/logo_connect.svg" alt="Connect Health & Fitness" class="h-7 w-auto" />
      <span class="text-xs uppercase tracking-widest font-semibold text-text">Menú</span>
    </div>
    <button
      id="close-hamburger-btn"
      class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center text-text hover:bg-white/20 active:scale-95 transition-all"
      aria-label="Cerrar menú"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Member Navigation Links (Logged In) -->
  <div id="mobile-drawer-member-links" class="flex-1 overflow-y-auto p-6 space-y-3">
    <a
      href="/"
      data-path="/"
      class="mobile-drawer-item flex items-center justify-between p-4 rounded-xl bg-surface/70 border border-white/10 text-text font-medium text-sm hover:border-accent/50 transition-all active:scale-[0.98]"
    >
      <div class="flex items-center gap-3">
        <svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
        </svg>
        <span class="uppercase tracking-wider text-xs">Inicio</span>
      </div>
      <svg class="w-4 h-4 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
    </a>

    <a
      href="/horarios"
      data-path="/horarios"
      class="mobile-drawer-item flex items-center justify-between p-4 rounded-xl bg-surface/70 border border-white/10 text-text font-medium text-sm hover:border-accent/50 transition-all active:scale-[0.98]"
    >
      <div class="flex items-center gap-3">
        <svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span class="uppercase tracking-wider text-xs">Horarios &amp; Eventos</span>
      </div>
      <svg class="w-4 h-4 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
    </a>

    <a
      href="/perfil"
      data-path="/perfil"
      class="mobile-drawer-item flex items-center justify-between p-4 rounded-xl bg-surface/70 border border-white/10 text-text font-medium text-sm hover:border-accent/50 transition-all active:scale-[0.98]"
    >
      <div class="flex items-center gap-3">
        <svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <rect x="3" y="4" width="18" height="16" rx="2" />
          <circle cx="9" cy="10" r="2.5" />
          <path d="M15 8h2M15 12h2M7 16h10" />
        </svg>
        <span class="uppercase tracking-wider text-xs">Mi Perfil</span>
      </div>
      <svg class="w-4 h-4 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
    </a>

    <button
      id="drawer-logout-btn"
      class="w-full flex items-center justify-between p-4 rounded-xl bg-red-500/10 border border-red-500/30 text-red-400 font-medium text-sm hover:bg-red-500/20 transition-all mt-6 active:scale-[0.98]"
    >
      <span class="uppercase tracking-wider text-xs">Cerrar Sesión</span>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12" />
      </svg>
    </button>
  </div>

  <!-- Guest Navigation Links (Unauthenticated) -->
  <div id="mobile-drawer-guest-links" class="flex-1 overflow-y-auto p-6 space-y-3 hidden">
    <a href="/#inicio" class="block p-3 rounded-lg text-xs uppercase tracking-widest text-text-muted hover:text-white hover:bg-white/5 transition-all">Inicio</a>
    <a href="/#horarios" class="block p-3 rounded-lg text-xs uppercase tracking-widest text-text-muted hover:text-white hover:bg-white/5 transition-all">Horarios</a>
    <a href="/#galeria" class="block p-3 rounded-lg text-xs uppercase tracking-widest text-text-muted hover:text-white hover:bg-white/5 transition-all">Galería</a>
    <a href="/#pet-friendly" class="block p-3 rounded-lg text-xs uppercase tracking-widest text-text-muted hover:text-white hover:bg-white/5 transition-all">Pet Friendly</a>
    <a href="/#eventos" class="block p-3 rounded-lg text-xs uppercase tracking-widest text-text-muted hover:text-white hover:bg-white/5 transition-all">Eventos</a>
    <a href="/#mapa" class="block p-3 rounded-lg text-xs uppercase tracking-widest text-text-muted hover:text-white hover:bg-white/5 transition-all">Mapa</a>
    <a href="/#contacto" class="block p-3 rounded-lg text-xs uppercase tracking-widest text-text-muted hover:text-white hover:bg-white/5 transition-all">Contacto</a>
    <a href="/login" class="mt-4 block w-full py-3.5 bg-accent text-bg text-center uppercase tracking-widest font-semibold rounded-lg text-xs shadow-lg">Ingresar como Socio</a>
  </div>
</div>

<script>
  const currentPath = window.location.pathname;

  // Check active session for header & mobile footer links
  const userJson = localStorage.getItem("connect_user");
  const guestBtn = document.getElementById("header-guest-btn");
  const userContainer = document.getElementById("header-user-container");
  const mobileBottomNav = document.getElementById("mobile-bottom-nav");

  const menuBtn = document.getElementById("header-user-menu-btn");
  const dropdown = document.getElementById("header-user-dropdown");
  const logoutBtn = document.getElementById("header-logout-btn");

  const guestNav = document.getElementById("header-guest-nav");
  const memberNav = document.getElementById("header-member-nav");
  const drawerMemberLinks = document.getElementById("mobile-drawer-member-links");
  const drawerGuestLinks = document.getElementById("mobile-drawer-guest-links");

  if (userJson) {
    if (guestNav) guestNav.className = "hidden items-center gap-6 lg:gap-8 justify-center";
    if (memberNav) memberNav.className = "hidden md:flex items-center gap-6 lg:gap-8 justify-center";

    drawerMemberLinks?.classList.remove("hidden");
    drawerGuestLinks?.classList.add("hidden");
    if (mobileBottomNav) mobileBottomNav.classList.remove("hidden");

    const memberLinks = document.querySelectorAll(".header-member-link");
    memberLinks.forEach((link) => {
      const path = link.getAttribute("data-member-path");
      let isActive = false;
      if (path === "/" && (currentPath === "/" || currentPath === "")) {
        isActive = true;
      } else if (path === "/horarios" && (currentPath.startsWith("/horarios") || currentPath.startsWith("/eventos"))) {
        isActive = true;
      } else if (path && path !== "/" && path !== "/horarios" && currentPath.startsWith(path)) {
        isActive = true;
      }

      if (isActive) {
        link.classList.remove("text-text-muted");
        link.classList.add("text-white", "font-semibold");
      }
    });

    // Highlight active mobile drawer link
    const drawerItems = document.querySelectorAll(".mobile-drawer-item");
    drawerItems.forEach((item) => {
      const path = item.getAttribute("data-path");
      let isActive = false;
      if (path === "/" && (currentPath === "/" || currentPath === "")) {
        isActive = true;
      } else if (path === "/horarios" && (currentPath.startsWith("/horarios") || currentPath.startsWith("/eventos"))) {
        isActive = true;
      } else if (path && path !== "/" && path !== "/horarios" && currentPath.startsWith(path)) {
        isActive = true;
      }

      if (isActive) {
        item.classList.add("border-accent", "bg-accent/10");
      }
    });

    try {
      const user = JSON.parse(userJson);

      if (guestBtn) guestBtn.style.display = "none";
      if (userContainer) userContainer.style.display = "block";

      const nameEl = document.getElementById("header-user-name");
      const planEl = document.getElementById("header-user-plan");
      const dropdownNameEl = document.getElementById("header-dropdown-name");
      const dropdownPlanEl = document.getElementById("header-dropdown-plan");
      const photoEl = document.getElementById("header-user-photo") as HTMLImageElement;
      const initialEl = document.getElementById("header-user-initial");

      const fullName = user.nombre || user.name || user.nombre_completo || "Lucas Silva";
      const planName = user.plan || "PLAN CONNECT";

      if (nameEl) nameEl.textContent = fullName;
      if (planEl) planEl.textContent = planName;
      if (dropdownNameEl) dropdownNameEl.textContent = fullName;
      if (dropdownPlanEl) dropdownPlanEl.textContent = planName;

      if (user.foto && photoEl && initialEl) {
        photoEl.src = user.foto;
        photoEl.style.display = "block";
        initialEl.style.display = "none";
      } else if (initialEl) {
        initialEl.textContent = fullName.charAt(0).toUpperCase();
        initialEl.style.display = "block";
        if (photoEl) photoEl.style.display = "none";
      }
    } catch {
      if (guestBtn) guestBtn.style.display = "inline-flex";
      if (userContainer) userContainer.style.display = "none";
    }
  } else {
    if (guestNav) guestNav.className = "hidden md:flex items-center gap-6 lg:gap-8 justify-center";
    if (memberNav) memberNav.className = "hidden items-center gap-6 lg:gap-8 justify-center";

    drawerMemberLinks?.classList.add("hidden");
    drawerGuestLinks?.classList.remove("hidden");
    if (mobileBottomNav) mobileBottomNav.classList.add("hidden");

    if (guestBtn) guestBtn.style.display = "inline-flex";
    if (userContainer) userContainer.style.display = "none";
  }

  // Hamburger Drawer Toggle Handlers
  const hamburgerBtn = document.getElementById("mobile-hamburger-btn");
  const closeHamburgerBtn = document.getElementById("close-hamburger-btn");
  const hamburgerDrawer = document.getElementById("mobile-hamburger-drawer");
  const drawerLogoutBtn = document.getElementById("drawer-logout-btn");

  hamburgerBtn?.addEventListener("click", () => {
    hamburgerDrawer?.classList.remove("hidden");
    hamburgerDrawer?.classList.add("flex");
  });

  closeHamburgerBtn?.addEventListener("click", () => {
    hamburgerDrawer?.classList.remove("flex");
    hamburgerDrawer?.classList.add("hidden");
  });

  // Close drawer when clicking any link inside it (hash links keep the URL on the same page)
  document.querySelectorAll("#mobile-hamburger-drawer a").forEach((link) => {
    link.addEventListener("click", () => {
      hamburgerDrawer?.classList.remove("flex");
      hamburgerDrawer?.classList.add("hidden");
    });
  });

  drawerLogoutBtn?.addEventListener("click", () => {
    localStorage.removeItem("connect_user");
    window.location.href = "/";
  });

  // Toggle Notifications dropdown menu
  const notifBtn = document.getElementById("notif-bell-btn");
  const notifDropdown = document.getElementById("notif-dropdown");
  const notifBadge = document.getElementById("notif-badge");
  const markAllBtn = document.getElementById("mark-all-read-btn");

  // Toggle User dropdown menu
  menuBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    notifDropdown?.classList.add("hidden");
    dropdown?.classList.toggle("hidden");
  });

  notifBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    dropdown?.classList.add("hidden");
    notifDropdown?.classList.toggle("hidden");
  });

  // Close all dropdowns when clicking outside
  document.addEventListener("click", () => {
    dropdown?.classList.add("hidden");
    notifDropdown?.classList.add("hidden");
  });

  // Notifications Sync Script
  function updateNotificationsUI() {
    const readNotifs: string[] = JSON.parse(localStorage.getItem("read_notifs") || "[]");
    const notifButtons = document.querySelectorAll(".notif-item-btn");
    let unreadCount = 0;

    notifButtons.forEach((btn) => {
      const id = btn.getAttribute("data-id");
      const dot = btn.querySelector(".notif-dot");

      if (id && readNotifs.includes(id)) {
        btn.classList.add("opacity-60");
        if (dot) dot.classList.add("bg-white/20");
        if (dot) dot.classList.remove("bg-accent");
      } else {
        btn.classList.remove("opacity-60");
        if (dot) dot.classList.remove("bg-white/20");
        if (dot) dot.classList.add("bg-accent");
        unreadCount++;
      }
    });

    if (notifBadge) {
      if (unreadCount > 0) {
        notifBadge.textContent = unreadCount.toString();
        notifBadge.classList.remove("hidden");
      } else {
        notifBadge.classList.add("hidden");
      }
    }
  }

  // Handle clicking a notification item to re-open announcement modal
  document.querySelectorAll(".notif-item-btn").forEach((btn) => {
    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      const idx = parseInt(btn.getAttribute("data-index") || "0", 10);
      const id = btn.getAttribute("data-id");

      if (id) {
        let readNotifs = JSON.parse(localStorage.getItem("read_notifs") || "[]");
        if (!readNotifs.includes(id)) {
          readNotifs.push(id);
          localStorage.setItem("read_notifs", JSON.stringify(readNotifs));
        }
      }

      notifDropdown?.classList.add("hidden");
      updateNotificationsUI();

      // Dispatch event to open AnnouncementModal at target slide
      window.dispatchEvent(
        new CustomEvent("open-announcement-modal", { detail: { index: idx } })
      );
    });
  });

  markAllBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    const allIds = Array.from(document.querySelectorAll(".notif-item-btn")).map((b) =>
      b.getAttribute("data-id")
    ).filter(Boolean);

    localStorage.setItem("read_notifs", JSON.stringify(allIds));
    updateNotificationsUI();
  });

  window.addEventListener("notifs-updated", updateNotificationsUI);
  updateNotificationsUI();

  // Handle logout
  logoutBtn?.addEventListener("click", () => {
    localStorage.removeItem("connect_user");
    window.location.href = "/login";
  });

  // Highlight active mobile footer nav item based on current route
  const mobileNavItems = document.querySelectorAll(".mobile-nav-item");

  mobileNavItems.forEach((item) => {
    const path = item.getAttribute("data-path");
    const icon = item.querySelector("svg");
    const label = item.querySelector("span");

    let isActive = false;
    if (path === "/" && (currentPath === "/" || currentPath === "")) {
      isActive = true;
    } else if (path === "/horarios" && (currentPath.startsWith("/horarios") || currentPath.startsWith("/eventos"))) {
      isActive = true;
    } else if (path && path !== "/" && path !== "/horarios" && currentPath.startsWith(path)) {
      isActive = true;
    } else if (path === "/perfil" && (currentPath.startsWith("/login") || currentPath.startsWith("/perfil"))) {
      isActive = true;
    }

    if (isActive) {
      item.classList.remove("text-text-muted", "opacity-70");
      item.classList.add("text-white");
      if (label) {
        label.classList.remove("font-light");
        label.classList.add("font-medium", "text-white");
      }
      if (icon) {
        icon.classList.add("text-white", "scale-110");
      }
    } else {
      item.classList.remove("text-white");
      item.classList.add("text-text-muted", "opacity-70");
      if (label) {
        label.classList.remove("font-medium", "text-white");
        label.classList.add("font-light");
      }
    }
  });

  // Dynamic Header Logo Switch, Glass Banner & Guest Button Visibility on Scroll
  const mainHeader = document.getElementById("main-header");
  const headerLogo = document.getElementById("header-logo") as HTMLImageElement;
  const logoSymbol = "/images/logo_connect.svg";
  const logoLetras = "/images/logo_connect_letras.svg";
  let logoSwapTimer: number | undefined;

  function handleHeaderScroll() {
    if (!headerLogo) return;

    const horariosElement = document.getElementById("horarios");
    let isScrolledPastHero = window.scrollY > 180;
    if (horariosElement) {
      const rect = horariosElement.getBoundingClientRect();
      if (rect.top <= 250) {
        isScrolledPastHero = true;
      }
    }

    // 1. Toggle Header Glass background state on scroll
    if (mainHeader) {
      if (isScrolledPastHero) {
        mainHeader.classList.remove("bg-transparent", "border-transparent", "backdrop-blur-none", "shadow-none");
        mainHeader.classList.add("bg-bg/75", "backdrop-blur-xl", "border-white/10", "shadow-[0_10px_30px_rgba(0,0,0,0.5),_inset_0_1px_0_rgba(255,255,255,0.1)]");
      } else {
        mainHeader.classList.remove("bg-bg/75", "backdrop-blur-xl", "border-white/10", "shadow-[0_10px_30px_rgba(0,0,0,0.5),_inset_0_1px_0_rgba(255,255,255,0.1)]");
        mainHeader.classList.add("bg-transparent", "border-transparent", "backdrop-blur-none", "shadow-none");
      }
    }

    // 2. Logo swap
    const targetState = isScrolledPastHero ? "letras" : "symbol";
    const targetSrc = isScrolledPastHero ? logoLetras : logoSymbol;

    if (headerLogo.getAttribute("data-state") !== targetState) {
      headerLogo.setAttribute("data-state", targetState);
      clearTimeout(logoSwapTimer);
      headerLogo.style.opacity = "0";
      logoSwapTimer = window.setTimeout(() => {
        headerLogo.src = targetSrc;
        headerLogo.style.opacity = "1";
      }, 120);
    }

    // 3. Fade in and smoothly expand header "Ingresar" button past Hero
    if (guestBtn) {
      if (isScrolledPastHero) {
        guestBtn.classList.remove("max-w-0", "opacity-0", "pointer-events-none", "border-0", "px-0");
        guestBtn.classList.add("max-w-[140px]", "opacity-100", "pointer-events-auto", "border", "border-white/20", "px-3", "sm:px-4");
      } else {
        guestBtn.classList.remove("max-w-[140px]", "opacity-100", "pointer-events-auto", "border", "border-white/20", "px-3", "sm:px-4");
        guestBtn.classList.add("max-w-0", "opacity-0", "pointer-events-none", "border-0", "px-0");
      }
    }
  }

  window.addEventListener("scroll", handleHeaderScroll, { passive: true });
  handleHeaderScroll();
</script>
