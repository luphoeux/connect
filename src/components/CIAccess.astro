---
---

<section id="acceso" class="py-24 px-6">
  <div class="max-w-md mx-auto text-center">
    <h2 class="text-3xl md:text-4xl font-light tracking-[0.15em] uppercase mb-4">
      Mi Cuenta
    </h2>
    <p class="text-text-muted font-light text-sm mb-12">
      Ingresá tu número de carnet de identidad para ver tu membresía
    </p>

    <form
      id="ci-form"
      class="flex flex-col gap-4"
    >
      <input
        id="ci-input"
        type="text"
        inputmode="numeric"
        placeholder="Número de Carnet"
        maxlength="20"
        autocomplete="off"
        class="w-full bg-transparent border border-white/10 px-6 py-4 text-text text-center text-lg font-light tracking-[0.1em] placeholder:text-text-muted/50 focus:outline-none focus:border-white/30 transition-colors duration-300"
      />

      <button
        type="submit"
        class="w-full bg-white text-bg px-6 py-4 uppercase text-sm tracking-[0.25em] font-medium hover:bg-white/90 transition-colors duration-300"
      >
        Consultar
      </button>
    </form>

    <div id="ci-result" class="mt-10 hidden">
      <p id="ci-error" class="text-red-400 text-sm hidden"></p>
      <div id="ci-card"></div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("ci-form") as HTMLFormElement;
  const input = document.getElementById("ci-input") as HTMLInputElement;
  const result = document.getElementById("ci-result") as HTMLDivElement;
  const errorEl = document.getElementById("ci-error") as HTMLParagraphElement;
  const cardEl = document.getElementById("ci-card") as HTMLDivElement;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const ci = input.value.trim();
    if (!ci) return;

    errorEl.classList.add("hidden");
    cardEl.innerHTML = "";

    try {
      const res = await fetch("/api/auth", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ ci }),
      });

      const data = await res.json();

      if (!res.ok) {
        errorEl.textContent = data.error || "No se encontró el miembro";
        errorEl.classList.remove("hidden");
        result.classList.remove("hidden");
        return;
      }

      renderCard(data);
    } catch {
      errorEl.textContent = "Error de conexión. Intentá de nuevo.";
      errorEl.classList.remove("hidden");
      result.classList.remove("hidden");
    }
  });

  function renderCard(member: {
    nombre: string;
    plan: string;
    fecha_caducacion: string;
    foto?: string;
  }) {
    const diasRestantes = Math.ceil(
      (new Date(member.fecha_caducacion).getTime() - Date.now()) / (1000 * 60 * 60 * 24)
    );
    const activo = diasRestantes > 0;
    const fechaFormateada = new Date(member.fecha_caducacion).toLocaleDateString("es-BO", {
      day: "numeric",
      month: "long",
      year: "numeric",
    });

    cardEl.innerHTML = `
      <div class="bg-surface border border-white/5 p-8 text-left">
        <div class="flex items-center gap-6">
          <div class="w-20 h-20 rounded-full bg-surface-mid flex items-center justify-center overflow-hidden flex-shrink-0">
            ${
              member.foto
                ? `<img src="${member.foto}" alt="${member.nombre}" class="w-full h-full object-cover" />`
                : `<span class="text-3xl font-light text-text-muted">${member.nombre.charAt(0)}</span>`
            }
          </div>
          <div>
            <h3 class="text-xl font-light tracking-[0.05em]">${member.nombre}</h3>
            <p class="text-accent text-sm mt-1 tracking-[0.15em] uppercase font-medium">${member.plan}</p>
          </div>
        </div>

        <div class="h-px w-full bg-white/5 my-6" />

        <div class="flex items-center justify-between">
          <div>
            <p class="text-text-muted text-xs tracking-[0.15em] uppercase">Vencimiento</p>
            <p class="text-text font-light mt-1">${fechaFormateada}</p>
          </div>
          <span class="px-4 py-1 text-xs tracking-[0.15em] uppercase font-medium ${
            activo ? "bg-green-500/10 text-green-400" : "bg-red-500/10 text-red-400"
          }">
            ${activo ? "Activo" : "Vencido"}
          </span>
        </div>

        ${activo ? `<p class="text-text-muted text-xs mt-4 font-light">${diasRestantes} días restantes</p>` : ""}
      </div>
    `;

    result.classList.remove("hidden");
  }
</script>
