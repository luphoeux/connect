---
// Componente de Historias & Reels para Connect Health & Fitness
export const reelsData = [
  {
    id: "reel-2096760101718303",
    titulo: "Reel Destacado Connect",
    descripcion: "Entrenamiento intensivo y momentos especiales de la comunidad Connect.",
    vistas: "14.2K",
    likes: "1.8K",
    fecha: "Reciente",
    videoUrl: "https://www.facebook.com/reel/2096760101718303",
    embedUrl: "https://www.facebook.com/plugins/video.php?href=https%3A%2F%2Fwww.facebook.com%2Freel%2F2096760101718303&show_text=false",
    thumbnail: "https://images.unsplash.com/photo-1517838277536-f5f99be501cd?auto=format&fit=crop&q=80&w=600",
    avatar: "/images/logo_connect.svg",
    categoria: "Destacado",
  },
  {
    id: "reel-2",
    titulo: "Clase de Body Combat",
    descripcion: "Energía total en nuestro Salón Connect con la instructora Cindy.",
    vistas: "8.9K",
    likes: "950",
    fecha: "Hace 4 días",
    videoUrl: "https://www.facebook.com/profile.php?id=100076283411100",
    embedUrl: "https://www.facebook.com/plugins/page.php?href=https%3A%2F%2Fwww.facebook.com%2Fprofile.php%3Fid%3D100076283411100&tabs=timeline&width=340&height=500&small_header=true&adapt_container_width=true&hide_cover=false&show_facepile=false",
    thumbnail: "https://images.unsplash.com/photo-1518611012118-696072aa579a?auto=format&fit=crop&q=80&w=600",
    avatar: "https://images.unsplash.com/photo-1518611012118-696072aa579a?auto=format&fit=crop&q=80&w=150",
    categoria: "Clases",
  },
  {
    id: "reel-3",
    titulo: "Tips de Sentadilla",
    descripcion: "Aprende a ejecutar la postura correcta con nuestros entrenadores certificados.",
    vistas: "15.1K",
    likes: "2.3K",
    fecha: "Hace 1 semana",
    videoUrl: "https://www.facebook.com/profile.php?id=100076283411100",
    embedUrl: "https://www.facebook.com/plugins/page.php?href=https%3A%2F%2Fwww.facebook.com%2Fprofile.php%3Fid%3D100076283411100&tabs=timeline&width=340&height=500&small_header=true&adapt_container_width=true&hide_cover=false&show_facepile=false",
    thumbnail: "https://images.unsplash.com/photo-1534438327276-14e5300c3a48?auto=format&fit=crop&q=80&w=600",
    avatar: "https://images.unsplash.com/photo-1534438327276-14e5300c3a48?auto=format&fit=crop&q=80&w=150",
    categoria: "Técnica",
  },
];
---

<section id="comunidad" class="py-24 px-4 sm:px-6 max-w-7xl mx-auto space-y-12">
  <!-- Header Title -->
  <div class="text-center max-w-3xl mx-auto">
    <div class="inline-flex items-center gap-2 px-3.5 py-1 bg-accent/10 border border-accent/30 text-accent text-[10px] uppercase tracking-[0.25em] font-medium mb-3">
      <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
        <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
      </svg>
      <span>Historias &amp; Reels de Facebook</span>
    </div>
    <h2 class="text-3xl sm:text-4xl font-light tracking-[0.15em] uppercase text-text mb-4">
      Historias de la Comunidad
    </h2>
    <p class="text-text-muted text-sm sm:text-base font-light leading-relaxed">
      Haz clic en las historias o en cualquier Reel para reproducir los videos verticales de nuestra comunidad.
    </p>
  </div>

  <!-- Circular Stories Avatars Bar (Estilo Historias de Facebook/Instagram) -->
  <div class="flex items-center justify-center gap-6 overflow-x-auto py-4 px-2 no-scrollbar">
    {reelsData.map((story, idx) => (
      <button
        class="open-story-modal-btn flex flex-col items-center gap-2 group focus:outline-none flex-shrink-0"
        data-index={idx}
        aria-label={`Ver historia ${story.titulo}`}
      >
        <div class="relative p-1 rounded-full bg-gradient-to-tr from-amber-500 to-accent group-hover:scale-105 transition-transform duration-300 shadow-lg">
          <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-surface overflow-hidden border-2 border-bg flex items-center justify-center">
            <img
              src={story.avatar || story.thumbnail}
              alt={story.titulo}
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
            />
          </div>
          <span class="absolute bottom-0 right-0 w-4 h-4 bg-accent border-2 border-bg rounded-full flex items-center justify-center text-[9px] font-bold text-bg">
            ▶
          </span>
        </div>
        <span class="text-[11px] uppercase tracking-wider text-text font-medium group-hover:text-accent transition-colors">
          {story.categoria}
        </span>
      </button>
    ))}
  </div>

  <!-- Reels Grid (Format Vertical 9:16) -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {reelsData.map((reel, idx) => (
      <div class="group relative bg-surface/90 border border-white/10 overflow-hidden shadow-2xl transition-all duration-500 hover:border-accent/40 hover:-translate-y-1">
        <!-- Reel Cover Image Container -->
        <div class="relative aspect-[9/16] w-full overflow-hidden bg-bg">
          <img
            src={reel.thumbnail}
            alt={reel.titulo}
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
          />

          <!-- Gradient Overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-bg via-bg/30 to-transparent"></div>

          <!-- Top Badge: Facebook Reel Icon -->
          <div class="absolute top-4 left-4 z-10 flex items-center gap-1.5 px-2.5 py-1 bg-black/60 backdrop-blur-md text-[10px] uppercase tracking-wider text-white border border-white/15">
            <svg class="w-3 h-3 text-accent" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
            <span>Historia / Reel</span>
          </div>

          <!-- Play Button Overlay Center -->
          <button
            class="open-story-modal-btn absolute inset-0 flex items-center justify-center z-10 cursor-pointer focus:outline-none"
            data-index={idx}
            aria-label={`Reproducir ${reel.titulo}`}
          >
            <div class="w-16 h-16 rounded-full bg-accent/90 text-bg border border-white/40 flex items-center justify-center group-hover:scale-110 group-hover:bg-white group-hover:text-bg transition-all duration-300 shadow-2xl">
              <svg class="w-7 h-7 ml-0.5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M8 5v14l11-7z"/>
              </svg>
            </div>
          </button>

          <!-- Bottom Content Overlay inside Reel -->
          <div class="absolute bottom-0 left-0 right-0 p-6 z-10 space-y-3 pointer-events-none">
            <!-- Stats Bar -->
            <div class="flex items-center gap-4 text-xs font-mono text-text-secondary">
              <span class="flex items-center gap-1">
                <svg class="w-4 h-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                {reel.vistas}
              </span>
              <span class="flex items-center gap-1">
                <svg class="w-4 h-4 text-red-400" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                </svg>
                {reel.likes}
              </span>
              <span class="text-[10px] text-text-muted ml-auto font-sans">{reel.fecha}</span>
            </div>

            <h3 class="text-lg font-medium text-text tracking-wide leading-tight group-hover:text-accent transition-colors">
              {reel.titulo}
            </h3>
            <p class="text-xs text-text-muted font-light line-clamp-2 leading-relaxed">
              {reel.descripcion}
            </p>

            <a
              href={reel.videoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 pt-2 text-xs uppercase tracking-[0.2em] font-medium text-accent hover:underline pointer-events-auto"
            >
              <span>Ver en Facebook</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Vertical Story Viewer Modal (Estilo Historias de Instagram / Facebook) -->
  <div
    id="story-player-modal"
    class="fixed inset-0 z-[100] flex items-center justify-center p-4 bg-black/95 backdrop-blur-md opacity-0 pointer-events-none transition-opacity duration-300"
    role="dialog"
    aria-modal="true"
  >
    <!-- Modal Frame 9:16 Vertical Phone -->
    <div class="relative w-full max-w-[400px] h-[680px] bg-[#121212] border border-white/20 shadow-2xl flex flex-col justify-between overflow-hidden">
      <!-- Top Story Bar Header -->
      <div class="p-4 bg-gradient-to-b from-black/90 to-transparent z-20 space-y-3">
        <!-- Progress Bars -->
        <div class="flex items-center gap-1.5">
          {reelsData.map((_, i) => (
            <div class="h-1 flex-1 bg-white/20 overflow-hidden rounded-full">
              <div class={`story-progress-bar h-full bg-accent w-0 transition-all duration-300`} data-progress-idx={i}></div>
            </div>
          ))}
        </div>

        <!-- Story User Header Info -->
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full border border-accent overflow-hidden bg-surface flex items-center justify-center">
              <img id="story-modal-avatar" src="/images/logo_connect.svg" alt="Connect" class="w-full h-full object-cover" />
            </div>
            <div>
              <p id="story-modal-title" class="text-xs font-medium text-white tracking-wide">--</p>
              <p class="text-[10px] text-accent tracking-wider font-light uppercase">Connect Health &amp; Fitness</p>
            </div>
          </div>

          <!-- Close Modal X -->
          <button
            id="close-story-modal-btn"
            class="text-white/70 hover:text-white p-2 focus:outline-none transition-colors"
            aria-label="Cerrar historia"
          >
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- iFrame Video Player Body -->
      <div class="absolute inset-0 pt-16 pb-14 bg-black flex items-center justify-center overflow-hidden">
        <iframe
          id="story-iframe"
          src=""
          width="100%"
          height="100%"
          style="border:none;overflow:hidden;"
          allowfullscreen="true"
          allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
          class="w-full h-full border-0"
        >
        </iframe>
      </div>

      <!-- Left / Right Navigation Overlay Controls -->
      <button
        id="story-prev-btn"
        class="absolute left-2 top-1/2 -translate-y-1/2 z-30 p-2 text-white/50 hover:text-white bg-black/40 hover:bg-black/80 rounded-full transition-all focus:outline-none"
        aria-label="Historia anterior"
      >
        ‹
      </button>
      <button
        id="story-next-btn"
        class="absolute right-2 top-1/2 -translate-y-1/2 z-30 p-2 text-white/50 hover:text-white bg-black/40 hover:bg-black/80 rounded-full transition-all focus:outline-none"
        aria-label="Historia siguiente"
      >
        ›
      </button>

      <!-- Bottom Footer CTA -->
      <div class="p-4 bg-gradient-to-t from-black/90 to-transparent z-20 text-center">
        <a
          id="story-modal-link"
          href="https://www.facebook.com/reel/2096760101718303"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.2em] font-medium text-accent hover:underline"
        >
          <span>Abrir Reel en Facebook</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ reelsData }}>
  const storyModal = document.getElementById("story-player-modal");
  const storyIframe = document.getElementById("story-iframe");
  const storyModalTitle = document.getElementById("story-modal-title");
  const storyModalAvatar = document.getElementById("story-modal-avatar");
  const storyModalLink = document.getElementById("story-modal-link");
  const closeStoryBtn = document.getElementById("close-story-modal-btn");
  const prevStoryBtn = document.getElementById("story-prev-btn");
  const nextStoryBtn = document.getElementById("story-next-btn");

  let currentStoryIndex = 0;

  function loadStory(index) {
    if (index < 0 || index >= reelsData.length) return;
    currentStoryIndex = index;
    const story = reelsData[currentStoryIndex];

    if (storyModalTitle) storyModalTitle.textContent = story.titulo;
    if (storyModalAvatar) storyModalAvatar.src = story.avatar || story.thumbnail;
    if (storyModalLink) storyModalLink.href = story.videoUrl;
    if (storyIframe) storyIframe.src = story.embedUrl;

    // Update progress bars
    document.querySelectorAll(".story-progress-bar").forEach((bar, idx) => {
      if (idx < currentStoryIndex) {
        bar.classList.remove("w-0");
        bar.classList.add("w-full");
      } else if (idx === currentStoryIndex) {
        bar.classList.remove("w-0");
        bar.classList.add("w-full");
      } else {
        bar.classList.remove("w-full");
        bar.classList.add("w-0");
      }
    });

    storyModal?.classList.remove("opacity-0", "pointer-events-none");
  }

  function closeStoryModal() {
    storyModal?.classList.add("opacity-0", "pointer-events-none");
    if (storyIframe) storyIframe.src = "";
  }

  document.querySelectorAll(".open-story-modal-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const idx = parseInt(btn.getAttribute("data-index") || "0", 10);
      loadStory(idx);
    });
  });

  closeStoryBtn?.addEventListener("click", closeStoryModal);
  prevStoryBtn?.addEventListener("click", () => loadStory(currentStoryIndex - 1));
  nextStoryBtn?.addEventListener("click", () => loadStory(currentStoryIndex + 1));

  storyModal?.addEventListener("click", (e) => {
    if (e.target === storyModal) closeStoryModal();
  });
</script>
