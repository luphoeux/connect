---
// Componente de Contacto, Ubicación y Formulario de Consulta Rápida
---

<section id="contacto" class="py-24 px-4 sm:px-6 max-w-7xl mx-auto space-y-16">
  <div class="text-center max-w-3xl mx-auto">
    <div class="inline-flex items-center gap-2 px-3.5 py-1 bg-accent/10 border border-accent/30 text-accent text-[10px] uppercase tracking-[0.25em] font-medium mb-3">
      <span>Visítanos o Escríbenos</span>
    </div>
    <h2 class="text-3xl sm:text-4xl font-light tracking-[0.15em] uppercase text-text mb-4">
      Contacto &amp; Ubicación
    </h2>
    <p class="text-text-muted text-sm sm:text-base font-light leading-relaxed">
      ¿Tienes preguntas sobre nuestros planes o quieres agendar un recorrido por las instalaciones? Ponte en contacto con nuestro equipo.
    </p>
  </div>

  <div class="grid lg:grid-cols-2 gap-12 items-start">
    <!-- Left Column: Contact Cards & WhatsApp CTA -->
    <div class="space-y-6">
      <div class="bg-surface/90 border border-white/10 p-8 backdrop-blur-xl space-y-6">
        <h3 class="text-xl font-light uppercase tracking-[0.1em] text-text border-b border-white/10 pb-4">
          Sucursal Principal — HQ Sur
        </h3>

        <div class="space-y-4">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-accent flex-shrink-0">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
              </svg>
            </div>
            <div>
              <p class="text-xs uppercase tracking-wider text-text-muted">Dirección</p>
              <p class="text-text font-light text-sm sm:text-base mt-0.5">Mall Plaza 21, Piso 3</p>
              <p class="text-text-muted text-xs">San Miguel, La Paz - Bolivia</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-accent flex-shrink-0">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <p class="text-xs uppercase tracking-wider text-text-muted">Atención Continua</p>
              <p class="text-text font-light text-sm sm:text-base mt-0.5">Lun a Vie: 06:00 a 23:00</p>
              <p class="text-text-muted text-xs">Sáb: 08:00 a 20:00 | Dom y Feriados: 09:00 a 15:00</p>
            </div>
          </div>
        </div>

        <div class="pt-4 border-t border-white/10">
          <a
            href="https://wa.me/59177254022"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center gap-3 px-6 py-4 bg-green-600/20 hover:bg-green-600 text-white border border-green-500/30 uppercase text-xs tracking-[0.2em] font-medium transition-all duration-300 shadow-xl"
          >
            <svg class="w-5 h-5 text-emerald-400 fill-current" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c-.001 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            <span>Consultar por WhatsApp (+591 77 25 40 22)</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Right Column: Interactive Quick Inquiry Form -->
    <div class="bg-surface/90 border border-white/10 p-8 backdrop-blur-xl">
      <h3 class="text-xl font-light uppercase tracking-[0.1em] text-text mb-6">
        Formulario de Consulta
      </h3>

      <form id="contact-form" class="space-y-5">
        <div>
          <label for="contact-name" class="block text-xs uppercase tracking-wider text-text-muted mb-2 font-medium">Nombre Completo</label>
          <input
            id="contact-name"
            type="text"
            required
            placeholder="Ej. Camila Morales"
            class="w-full bg-bg/80 border border-white/15 px-4 py-3 text-text text-sm font-light placeholder:text-text-muted/40 focus:outline-none focus:border-accent transition-colors"
          />
        </div>

        <div>
          <label for="contact-email" class="block text-xs uppercase tracking-wider text-text-muted mb-2 font-medium">Correo o WhatsApp</label>
          <input
            id="contact-email"
            type="text"
            required
            placeholder="Ej. +591 70000000 o correo@ejemplo.com"
            class="w-full bg-bg/80 border border-white/15 px-4 py-3 text-text text-sm font-light placeholder:text-text-muted/40 focus:outline-none focus:border-accent transition-colors"
          />
        </div>

        <div>
          <label for="contact-message" class="block text-xs uppercase tracking-wider text-text-muted mb-2 font-medium">Consulta o Interés</label>
          <textarea
            id="contact-message"
            rows="4"
            required
            placeholder="¿Te interesa algún plan, horarios o una prueba gratis?"
            class="w-full bg-bg/80 border border-white/15 px-4 py-3 text-text text-sm font-light placeholder:text-text-muted/40 focus:outline-none focus:border-accent transition-colors resize-none"
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full bg-accent text-bg px-6 py-4 uppercase text-xs tracking-[0.25em] font-medium hover:bg-white transition-all shadow-lg"
        >
          Enviar Consulta
        </button>

        <p id="contact-success" class="text-xs text-green-400 text-center font-light hidden">
          ✓ ¡Mensaje enviado con éxito! Nos pondremos en contacto contigo a la brevedad.
        </p>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const successMsg = document.getElementById("contact-success") as HTMLParagraphElement;

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    successMsg?.classList.remove("hidden");
    form.reset();
    setTimeout(() => {
      successMsg?.classList.add("hidden");
    }, 4000);
  });
</script>
