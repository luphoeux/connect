---
import { formatRelativeDate } from "../lib/dates";
import { getPosts, usesLiveFacebook, type GymPost } from "../lib/facebook";
import PostCard from "./PostCard.astro";

const posts = await getPosts();
const live = usesLiveFacebook();
---

<section class="py-24 px-6">
  <div class="max-w-3xl mx-auto">
    <div class="flex items-end justify-between mb-12">
      <h2 class="text-3xl md:text-4xl font-light tracking-[0.15em] uppercase">
        Publicaciones
      </h2>
      {live && (
        <span class="text-accent text-xs tracking-[0.3em] uppercase font-medium">
          En vivo
        </span>
      )}
    </div>

    <div class="flex flex-col gap-8">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </div>
</section>