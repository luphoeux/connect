  {
    id: 1,
    categoria: "musculacion",
    categoriaNombre: "Musculación",
    titulo: "Zona de Pesas & Fuerza",
    descripcion: "Equipamiento de alta gama para entrenamiento de fuerza y sobrecarga progresiva.",
    imagen: "https://images.unsplash.com/photo-1534438327276-14e5300c3a48?auto=format&fit=crop&q=80&w=800",
  },
  {
    id: 2,
    categoria: "cardio",
    categoriaNombre: "Cardiovascular",
    titulo: "Área de Cardio de Última Generación",
    descripcion: "Caminadoras, elípticas y escaladoras con pantallas interactivas y monitoreo de ritmo.",
    imagen: "https://images.unsplash.com/photo-1540497077202-7c8a3999166f?auto=format&fit=crop&q=80&w=800",
  },
  {
    id: 3,
    categoria: "salones",
    categoriaNombre: "Salones Dirigidos",
    titulo: "Salón Connect",
    descripcion: "Espacio amplio con piso técnico acústico para clases de Pilates, Body Combat y Yoga.",
    imagen: "https://images.unsplash.com/photo-1518611012118-696072aa579a?auto=format&fit=crop&q=80&w=800",
  },
  {
    id: 4,
    categoria: "salones",
    categoriaNombre: "Indoor Cycling",
    titulo: "Sala de Spinning & Rhythm",
    descripcion: "Bicicletas de precisión con sistema de luces inmersivo y audio de alta fidelidad.",
    imagen: "https://images.unsplash.com/photo-1517838277536-f5f99be501cd?auto=format&fit=crop&q=80&w=800",
  },
  {
    id: 5,
    categoria: "musculacion",
    categoriaNombre: "Funcional & HIIT",
    titulo: "Zona de Entrenamiento Funcional",
    descripcion: "Racks, trineos, kettebells y césped sintético para acondicionamiento atlético.",
    imagen: "https://images.unsplash.com/photo-1571902943202-507ec2618e8f?auto=format&fit=crop&q=80&w=800",
  },
  {
    id: 6,
    categoria: "instalaciones",
    categoriaNombre: "Instalaciones",
    titulo: "Vestuarios & Lockers Premium",
    descripcion: "Duchas calientes, lockers de seguridad y área de descanso equipada.",
    imagen: "https://images.unsplash.com/photo-1584735935682-2f2b69dff9d2?auto=format&fit=crop&q=80&w=800",
