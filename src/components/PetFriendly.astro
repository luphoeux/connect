---
// Componente de Normas Pet Friendly para Connect Health & Fitness
export const normasPetFriendly = [
  {
    num: 1,
    titulo: "El perro siempre debe estar con correa",
    desc: "Mantén a tu mascota bajo control en todo momento para garantizar la seguridad de todos."
  },
  {
    num: 2,
    titulo: "Respeta las áreas de anclaje y supervisa a tu perro",
    desc: "Usa las zonas designadas para atar a tu mascota y nunca la dejes sin supervisión."
  },
  {
    num: 3,
    titulo: "Mantén todo limpio",
    desc: "Asegúrate de recoger cualquier desecho de tu mascota y de dejar el espacio en perfectas condiciones."
  },
  {
    num: 4,
    titulo: "Tu perro debe estar en calma y ser sociable",
    desc: "Solo se permiten perros tranquilos y acostumbrados a interactuar positivamente con personas y otros perros."
  },
  {
    num: 5,
    titulo: "No llames ni des comida a perros que no sean tuyos",
    desc: "Respeta el espacio y las reglas de otros tutores."
  },
  {
    num: 6,
    titulo: "Antes de tocar a un perro, pide permiso a su tutor",
    desc: "No todos los perros disfrutan del contacto con extraños; siempre pregunta antes."
  },
  {
    num: 7,
    titulo: "Trae bolsitas para imprevistos",
    desc: "Sé responsable y preparado para recoger los desechos de tu mascota en cualquier momento."
  },
  {
    num: 8,
    titulo: "Pasea a tu perro al menos 20 min antes de venir",
    desc: "Esto ayudará a que tu perro llegue tranquilo y relajado al gimnasio."
  },
  {
    num: 9,
    titulo: "Eres responsable de todo lo que haga tu perro",
    desc: "Connect Fitness no se hace responsable de accidentes o inconvenientes ocasionados por tu mascota."
  },
  {
    num: 10,
    titulo: "Capacidad máxima: 5 perros",
    desc: "El número máximo de perros permitidos en el gimnasio al mismo tiempo es 5.",
    destacado: true
  },
  {
    num: 11,
    titulo: "Inscribe a tu perro para más beneficios",
    desc: "Registra a tu mascota para acceder a promociones y servicios exclusivos."
  },
  {
    num: 12,
    titulo: "Disfruta de tus actividades junto a ellos",
    desc: "Haz que la experiencia sea única para ti y tu perro."
  },
  {
    num: 13,
    titulo: "Animalbliss Bolivia",
    desc: "Esta iniciativa es parte de nuestro compromiso con el bienestar animal.",
    destacado: true
  }
];
---

<section id="pet-friendly" class="py-20 px-4 sm:px-6 max-w-7xl mx-auto space-y-12 relative">
  <!-- Section Header -->
  <div class="text-center max-w-3xl mx-auto space-y-4">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs uppercase tracking-[0.25em] font-medium">
      <svg class="w-4 h-4 text-amber-400" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 10c-3.1 0-5.5 2.1-5.5 4.5 0 2.1 2.4 4.5 5.5 4.5s5.5-2.4 5.5-4.5c0-2.4-2.4-4.5-5.5-4.5z"/>
        <ellipse cx="6.5" cy="7.5" rx="1.8" ry="2.5"/>
        <ellipse cx="10" cy="5" rx="1.8" ry="2.5"/>
        <ellipse cx="14" cy="5" rx="1.8" ry="2.5"/>
        <ellipse cx="17.5" cy="7.5" rx="1.8" ry="2.5"/>
      </svg>
      <span>Comunidad Connect</span>
    </div>

    <h2 class="text-3xl sm:text-4xl md:text-5xl font-light tracking-[0.15em] uppercase text-text">
      Normas <span class="font-bold text-amber-400">Pet Friendly</span>
    </h2>

    <p class="text-text-muted text-sm sm:text-base font-light leading-relaxed max-w-2xl mx-auto">
      En Connect Health &amp; Fitness tu mascota es bienvenida. Conoce nuestro reglamento oficial para garantizar una convivencia armónica, limpia y segura para toda la comunidad.
    </p>

    <!-- Highlight Banners -->
    <div class="pt-4 flex flex-wrap items-center justify-center gap-4 text-xs sm:text-sm">
      <div class="flex items-center gap-2.5 px-4 py-2 bg-surface/90 border border-amber-500/30 text-text">
        <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
        <span class="font-medium">Capacidad Máxima:</span>
        <span class="text-amber-400 font-bold">5 Perros en simultáneo</span>
      </div>

      <div class="flex items-center gap-2.5 px-4 py-2 bg-surface/90 border border-white/10 text-text">
        <svg class="w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
        </svg>
        <span class="font-medium">Alianza Oficial:</span>
        <span class="text-text-muted font-light">Animalbliss Bolivia</span>
      </div>
    </div>
  </div>

  <!-- Carousel with navigation arrows -->
  <div class="relative pt-2">
    <!-- Prev Arrow -->
    <button
      id="pet-carousel-prev"
      class="absolute left-0 top-1/2 -translate-y-1/2 z-10 w-10 h-10 rounded-full bg-surface/90 border border-white/20 flex items-center justify-center text-text hover:bg-white/10 active:scale-95 transition-all hidden sm:flex"
      aria-label="Norma Anterior"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
      </svg>
    </button>

    <!-- Next Arrow -->
    <button
      id="pet-carousel-next"
      class="absolute right-0 top-1/2 -translate-y-1/2 z-10 w-10 h-10 rounded-full bg-surface/90 border border-amber-500/40 flex items-center justify-center text-amber-400 hover:bg-amber-500/20 active:scale-95 transition-all hidden sm:flex"
      aria-label="Siguiente Norma"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
      </svg>
    </button>

    <!-- Scrollable Snap Container -->
    <div
      id="pet-carousel-container"
      class="flex overflow-x-auto snap-x snap-mandatory gap-4 py-2 scrollbar-none scroll-smooth sm:px-12"
      style="-webkit-overflow-scrolling: touch;"
    >
      {normasPetFriendly.map((norma) => (
        <div
          class={`pet-card flex-shrink-0 snap-center p-6 bg-surface/90 border backdrop-blur-md transition-all duration-300 ${
            norma.destacado
              ? "border-amber-500/50 bg-amber-500/5 shadow-lg shadow-amber-500/5"
              : "border-white/10 hover:border-white/25 hover:bg-surface"
          }`}
          style="width: min(85vw, 360px);"
        >
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class={`inline-flex items-center justify-center w-8 h-8 rounded-full text-xs font-bold ${
                norma.destacado ? "bg-amber-500 text-bg" : "bg-white/10 text-amber-400"
              }`}>
                {norma.num < 10 ? `0${norma.num}` : norma.num}
              </span>
              {norma.destacado && (
                <span class="text-[10px] uppercase tracking-wider px-2 py-0.5 bg-amber-500/20 text-amber-300 border border-amber-500/40 font-semibold">Importante</span>
              )}
            </div>
            <div>
              <h3 class="text-base font-semibold text-text uppercase tracking-wide group-hover:text-amber-400 transition-colors leading-snug">
                {norma.titulo}
              </h3>
              <p class="text-xs sm:text-sm text-text-muted font-light leading-relaxed mt-2">
                {norma.desc}
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Bottom Commitment Footer Note -->
  <div class="bg-surface/90 border border-white/10 p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-6 text-center sm:text-left">
    <div class="flex items-center gap-4">
      <div class="w-12 h-12 rounded-full bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400 flex-shrink-0">
        <svg class="w-6 h-6 text-amber-400" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 10c-3.1 0-5.5 2.1-5.5 4.5 0 2.1 2.4 4.5 5.5 4.5s5.5-2.4 5.5-4.5c0-2.4-2.4-4.5-5.5-4.5z"/>
          <ellipse cx="6.5" cy="7.5" rx="1.8" ry="2.5"/>
          <ellipse cx="10" cy="5" rx="1.8" ry="2.5"/>
          <ellipse cx="14" cy="5" rx="1.8" ry="2.5"/>
          <ellipse cx="17.5" cy="7.5" rx="1.8" ry="2.5"/>
        </svg>
      </div>
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider text-text">Iniciativa Animalbliss Bolivia</h4>
        <p class="text-xs text-text-muted font-light mt-0.5">
          Esta iniciativa es parte de nuestro compromiso activo con la tenencia responsable y el bienestar animal en La Paz.
        </p>
      </div>
    </div>
    <a
      href="https://wa.me/59177254022?text=Hola%20Connect,%20quisiera%20registrar%20a%20mi%20mascota"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 px-5 py-3 bg-amber-500 hover:bg-amber-400 text-bg font-bold text-xs uppercase tracking-widest transition-all duration-300 shadow-lg flex-shrink-0"
    >
      <span>Inscribir a mi mascota</span>
    </a>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('pet-carousel-container');
    const prevBtn = document.getElementById('pet-carousel-prev');
    const nextBtn = document.getElementById('pet-carousel-next');

    if (container && prevBtn && nextBtn) {
      const scrollAmount = () => container.clientWidth > 0 ? container.clientWidth * 0.85 : 360;

      prevBtn.addEventListener('click', () => {
        container.scrollBy({ left: -scrollAmount(), behavior: 'smooth' });
      });
      nextBtn.addEventListener('click', () => {
        container.scrollBy({ left: scrollAmount(), behavior: 'smooth' });
      });
    }
  });
</script>
