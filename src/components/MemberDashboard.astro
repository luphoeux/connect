---
import { getStories } from "../lib/facebook";

const stories = await getStories();
---

<section id="member-dashboard-section" class="pt-24 sm:pt-28 md:pt-32 pb-12 px-4 sm:px-6 max-w-7xl mx-auto space-y-8">
  <!-- TOP SECTION: Facebook-Style Stories Reel -->
  <div class="relative">
    <div class="mb-3 px-1">
      <h2 class="text-xs uppercase tracking-[0.2em] font-medium text-text-muted">
        Historias &amp; Novedades
      </h2>
    </div>

    <!-- Scrollable Snap Stories Reel -->
    <div
      id="stories-reel-container"
      class="flex gap-3 overflow-x-auto pb-2 snap-x snap-mandatory scrollbar-none scroll-smooth"
      style="-webkit-overflow-scrolling: touch;"
    >
      {stories.map((story, idx) => (
        <button
          class="dash-story-item snap-start flex-shrink-0 w-32 sm:w-36 aspect-[9/16] rounded-2xl overflow-hidden relative group cursor-pointer border border-white/10 hover:border-accent/60 transition-all duration-300 shadow-xl bg-black"
          data-index={idx}
          data-id={story.id}
          data-video={story.video || ""}
          data-imagen={story.imagen || ""}
          data-duracion={story.duracion_s ?? ""}
        >
          <!-- Full Bleed Card Media -->
          {story.imagen ? (
            <img
              src={story.imagen}
              alt={story.title}
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          ) : story.video ? (
            <video
              src={story.video}
              muted
              playsinline
              preload="metadata"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          ) : (
            <div class="w-full h-full" style={`background: ${story.gradient};`}></div>
          )}

          <!-- Top-Left Profile Avatar Circle with Blue Ring -->
          <div class="absolute top-2.5 left-2.5 z-10">
            <div class="dash-story-ring w-8 h-8 rounded-full bg-black border-2 border-blue-500 p-0.5 shadow-lg flex items-center justify-center overflow-hidden">
              <img src="/images/logo_connect_letras.svg" alt="Connect" class="w-full h-full object-contain p-0.5" />
            </div>
          </div>

          <!-- Video Play Icon Badge -->
          {story.video && (
            <div class="absolute inset-0 bg-black/20 group-hover:bg-black/10 transition-colors pointer-events-none">
            </div>
          )}

        </button>
      ))}
    </div>
  </div>

  <!-- Welcome Header Card -->
  <div class="bg-surface/90 border border-white/15 p-6 sm:p-8 backdrop-blur-xl relative overflow-hidden shadow-2xl">
    <div class="absolute -top-12 -right-12 w-64 h-64 bg-accent/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 relative z-10">
      <!-- Left: User Info & Avatar -->
      <div class="flex items-center gap-4 sm:gap-6">
        <div class="relative">
          <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-surface-mid border-2 border-accent/60 overflow-hidden flex items-center justify-center shadow-xl flex-shrink-0">
            <img id="dash-user-photo" src="" alt="" class="w-full h-full object-cover hidden" />
            <span id="dash-user-initial" class="text-2xl sm:text-3xl font-bold text-text">S</span>
          </div>
          <span class="absolute bottom-0 right-0 w-5 h-5 bg-emerald-500 border-2 border-bg rounded-full" title="Plan Activo"></span>
        </div>

        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <span class="px-2.5 py-0.5 bg-accent/15 border border-accent/40 text-accent text-[10px] uppercase tracking-widest font-semibold">
              Socio Activo
            </span>
            <span id="dash-user-ci" class="text-[11px] text-text-muted font-light">CI: --</span>
          </div>
          <h1 id="dash-user-name" class="text-2xl sm:text-3xl font-light tracking-wide text-text uppercase">
            Cargando...
          </h1>
          <div class="flex items-center gap-3 text-xs text-text-muted font-light">
            <span id="dash-user-plan" class="text-accent font-medium">Pase Libre</span>
            <span>•</span>
            <span id="dash-user-venc" class="text-emerald-400 font-light">Vigente (18 días restantes)</span>
          </div>
        </div>
      </div>

      <!-- Right: Credencial QR Quick Action -->
      <div class="flex flex-wrap items-center gap-3 pt-2 md:pt-0">
        <a
          href="/perfil"
          class="inline-flex items-center gap-2.5 px-5 py-3 bg-accent hover:bg-accent/90 text-bg font-bold text-xs uppercase tracking-widest transition-all duration-300 shadow-xl"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <rect x="3" y="4" width="18" height="16" rx="2" />
            <circle cx="9" cy="10" r="2.5" />
            <path d="M15 8h2M15 12h2M7 16h10" />
          </svg>
          <span>Mi Credencial QR</span>
        </a>

        <button
          id="dash-logout-btn"
          class="inline-flex items-center gap-2 px-4 py-3 bg-white/5 hover:bg-white/10 border border-white/15 text-text-muted hover:text-white text-xs uppercase tracking-wider transition-all"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75" />
          </svg>
          <span>Salir</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Member Stats Grid (4 Cards) -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
    <!-- Stat 1: Asistencias del Mes -->
    <div class="bg-surface/80 border border-white/10 p-5 sm:p-6 backdrop-blur-md space-y-3 relative overflow-hidden group hover:border-white/20 transition-all">
      <div class="flex items-center justify-between text-text-muted">
        <span class="text-[11px] uppercase tracking-wider font-medium">Asistencias</span>
        <div class="w-8 h-8 rounded-full bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
          </svg>
        </div>
      </div>
      <div>
        <div class="flex items-baseline gap-2">
          <span class="text-2xl sm:text-3xl font-bold text-text">14</span>
          <span class="text-xs text-text-muted font-light">/ 20 días</span>
        </div>
        <div class="w-full bg-white/10 h-1.5 rounded-full mt-3 overflow-hidden">
          <div class="bg-amber-400 h-full rounded-full" style="width: 70%;"></div>
        </div>
      </div>
      <p class="text-[10px] text-emerald-400 font-light">+3 entrenamientos vs mes pasado</p>
    </div>

    <!-- Stat 2: Racha de Entrenamiento -->
    <div class="bg-surface/80 border border-white/10 p-5 sm:p-6 backdrop-blur-md space-y-3 relative overflow-hidden group hover:border-white/20 transition-all">
      <div class="flex items-center justify-between text-text-muted">
        <span class="text-[11px] uppercase tracking-wider font-medium">Racha Activa</span>
        <div class="w-8 h-8 rounded-full bg-orange-500/10 border border-orange-500/20 flex items-center justify-center text-orange-400">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 23c-4.97 0-9-3.58-9-8 0-4.05 3.03-7.58 6.94-9.3.41-.18.88.08.94.53.11.83.47 2.06 1.15 2.76.62.64 1.41.97 2.19.97 1.84 0 3.25-1.52 3.25-3.37 0-.58-.15-1.15-.43-1.66-.23-.42.12-.93.59-.83C20.06 5.21 21 8.87 21 12c0 6.08-4.03 11-9 11z"/>
          </svg>
        </div>
      </div>
      <div>
        <div class="flex items-baseline gap-2">
          <span class="text-2xl sm:text-3xl font-bold text-orange-400">4 Días</span>
        </div>
        <p class="text-xs text-text-muted font-light mt-1">¡Mantén el ritmo esta semana!</p>
      </div>
      <p class="text-[10px] text-text-muted font-light">Último ingreso: Hoy, 07:30 AM</p>
    </div>

    <!-- Stat 3: Membresía Vencimiento -->
    <div class="bg-surface/80 border border-white/10 p-5 sm:p-6 backdrop-blur-md space-y-3 relative overflow-hidden group hover:border-white/20 transition-all">
      <div class="flex items-center justify-between text-text-muted">
        <span class="text-[11px] uppercase tracking-wider font-medium">Días Restantes</span>
        <div class="w-8 h-8 rounded-full bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
      </div>
      <div>
        <div class="flex items-baseline gap-2">
          <span id="dash-days-left" class="text-2xl sm:text-3xl font-bold text-emerald-400">18</span>
          <span class="text-xs text-text-muted font-light">días</span>
        </div>
        <p class="text-xs text-text-muted font-light mt-1">Vence el 29 de Agosto</p>
      </div>
      <p class="text-[10px] text-accent font-medium hover:underline cursor-pointer">Solicitar Renovación ↗</p>
    </div>

    <!-- Stat 4: Horario de Hoy HQ -->
    <div class="bg-surface/80 border border-white/10 p-5 sm:p-6 backdrop-blur-md space-y-3 relative overflow-hidden group hover:border-white/20 transition-all">
      <div class="flex items-center justify-between text-text-muted">
        <span class="text-[11px] uppercase tracking-wider font-medium">Atención Hoy</span>
        <div class="w-8 h-8 rounded-full bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-400">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
          </svg>
        </div>
      </div>
      <div>
        <span class="text-xl sm:text-2xl font-semibold text-text block">06:00 - 23:00</span>
        <span class="text-xs text-emerald-400 font-medium inline-flex items-center gap-1.5 mt-1">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          Abierto ahora en Sur HQ
        </span>
      </div>
      <p class="text-[10px] text-text-muted font-light">Mall Plaza 21, Piso 3</p>
    </div>
  </div>

  <!-- Member Quick Actions Grid -->
  <div class="space-y-4">
    <h3 class="text-xs uppercase tracking-[0.2em] font-medium text-text-muted">
      Acciones Rápidas del Miembro
    </h3>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <a
        href="/perfil"
        class="p-5 bg-surface/80 border border-white/10 hover:border-accent/40 transition-all group flex flex-col items-center text-center space-y-3"
      >
        <div class="w-12 h-12 rounded-full bg-accent/10 border border-accent/30 flex items-center justify-center text-accent group-hover:scale-110 transition-transform">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <rect x="3" y="4" width="18" height="16" rx="2" />
            <circle cx="9" cy="10" r="2.5" />
            <path d="M15 8h2M15 12h2M7 16h10" />
          </svg>
        </div>
        <div>
          <span class="text-xs uppercase tracking-wider font-medium text-text block group-hover:text-accent transition-colors">Mi Credencial</span>
          <span class="text-[10px] text-text-muted font-light">Código QR &amp; Carnet</span>
        </div>
      </a>

      <a
        href="/horarios"
        class="p-5 bg-surface/80 border border-white/10 hover:border-accent/40 transition-all group flex flex-col items-center text-center space-y-3"
      >
        <div class="w-12 h-12 rounded-full bg-blue-500/10 border border-blue-500/30 flex items-center justify-center text-blue-400 group-hover:scale-110 transition-transform">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div>
          <span class="text-xs uppercase tracking-wider font-medium text-text block group-hover:text-amber-400 transition-colors">Horarios &amp; Planes</span>
          <span class="text-[10px] text-text-muted font-light">Atención &amp; Tarifas</span>
        </div>
      </a>

      <a
        href="/eventos"
        class="p-5 bg-surface/80 border border-white/10 hover:border-accent/40 transition-all group flex flex-col items-center text-center space-y-3"
      >
        <div class="w-12 h-12 rounded-full bg-orange-500/10 border border-orange-500/30 flex items-center justify-center text-orange-400 group-hover:scale-110 transition-transform">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 003-3V8.25a3 3 0 00-3-3h-9a3 3 0 00-3 3v7.5a3 3 0 003 3m9 0v-1.5m-9 1.5v-1.5" />
          </svg>
        </div>
        <div>
          <span class="text-xs uppercase tracking-wider font-medium text-text block group-hover:text-orange-400 transition-colors">Desafíos &amp; Eventos</span>
          <span class="text-[10px] text-text-muted font-light">Inscripciones abiertas</span>
        </div>
      </a>

      <a
        href="https://wa.me/59177254022?text=Hola%20Connect,%20soy%20socio%20y%20tengo%20una%20consulta"
        target="_blank"
        rel="noopener noreferrer"
        class="p-5 bg-surface/80 border border-white/10 hover:border-emerald-500/40 transition-all group flex flex-col items-center text-center space-y-3"
      >
        <div class="w-12 h-12 rounded-full bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 group-hover:scale-110 transition-transform">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338-11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
          </svg>
        </div>
        <div>
          <span class="text-xs uppercase tracking-wider font-medium text-text block group-hover:text-emerald-400 transition-colors">Soporte WhatsApp</span>
          <span class="text-[10px] text-text-muted font-light">Atención en Recepción</span>
        </div>
      </a>
    </div>
  </div>
</section>

<!-- Client Script for Member Dashboard Hydration, Carousel Scrolling & Story Modal -->
<script>
  import { openStoryViewer } from "./StoryViewer";
  import { getSeenStories, markStorySeen, isStorySeen } from "../lib/seenStories";

  function initMemberDashboard() {
    const userJson = localStorage.getItem("connect_user");
    if (!userJson) return;

    try {
      const user = JSON.parse(userJson);
      const nameEl = document.getElementById("dash-user-name");
      const ciEl = document.getElementById("dash-user-ci");
      const planEl = document.getElementById("dash-user-plan");
      const initialEl = document.getElementById("dash-user-initial");
      const photoEl = document.getElementById("dash-user-photo") as HTMLImageElement;

      const name = user.nombre || "Socio";
      if (nameEl) nameEl.textContent = name;
      if (ciEl) ciEl.textContent = `CI: ${user.ci || '--'}`;
      if (planEl) planEl.textContent = user.plan || "Pase Libre";

      if (user.foto && photoEl && initialEl) {
        photoEl.src = user.foto;
        photoEl.classList.remove("hidden");
        initialEl.classList.add("hidden");
      } else if (initialEl) {
        initialEl.textContent = name.charAt(0).toUpperCase();
      }
    } catch (err) {
      console.error("[Dashboard] error parsing user data", err);
    }

    // Scroll Control for Stories Reel
    const reelContainer = document.getElementById("stories-reel-container");
    const prevBtn = document.getElementById("stories-scroll-prev");
    const nextBtn = document.getElementById("stories-scroll-next");

    if (reelContainer && prevBtn && nextBtn) {
      prevBtn.addEventListener("click", () => {
        reelContainer.scrollBy({ left: -260, behavior: "smooth" });
      });

      nextBtn.addEventListener("click", () => {
        reelContainer.scrollBy({ left: 260, behavior: "smooth" });
      });
    }
  }

  // Handle Logout Button
  document.getElementById("dash-logout-btn")?.addEventListener("click", () => {
    localStorage.removeItem("connect_user");
    window.location.reload();
  });

  // Story seen-state + reorder queue (Facebook-style)
  const reelContainer = document.getElementById("stories-reel-container");
  const seenSet = new Set(getSeenStories());

  const syncSeenRings = () => {
    document.querySelectorAll<HTMLElement>(".dash-story-item").forEach((item) => {
      const id = item.getAttribute("data-id");
      const ring = item.querySelector<HTMLElement>(".dash-story-ring");
      if (!ring) return;
      if (id && seenSet.has(id)) {
        ring.classList.remove("border-blue-500");
        ring.classList.add("border-white/20");
      }
    });
  };

  const reorderQueue = () => {
    if (!reelContainer) return;
    const items = Array.from(reelContainer.children) as HTMLElement[];
    const checked = new Set<string>();
    items.forEach((item) => {
      const id = item.getAttribute("data-id");
      if (!id || checked.has(id)) return;
      checked.add(id);
      if (seenSet.has(id)) reelContainer.appendChild(item);
    });
    syncSeenRings();
  };

  syncSeenRings();
  reorderQueue();

  // Story Item Modal Click Handler
  document.querySelectorAll(".dash-story-item").forEach((btn) => {
    btn.addEventListener("click", () => {
      const items = Array.from(document.querySelectorAll(".dash-story-item"));
      const startIdx = Math.max(0, items.indexOf(btn));
      const viewerItems = items.map((b) => ({
        video: b.getAttribute("data-video") || null,
        imagen: b.getAttribute("data-imagen") || null,
        duracion_s: Number(b.getAttribute("data-duracion")) || null,
      }));
      openStoryViewer(viewerItems, startIdx, (currentIdx) => {
        const current = items[currentIdx];
        const currentId = current?.getAttribute("data-id");
        if (currentId) {
          markStorySeen(currentId);
          seenSet.add(currentId);
          const ring = current?.querySelector(".dash-story-ring");
          if (ring) {
            ring.classList.remove("border-blue-500");
            ring.classList.add("border-white/20");
          }
        }
      });
    });
  });

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initMemberDashboard);
  } else {
    initMemberDashboard();
  }
</script>
