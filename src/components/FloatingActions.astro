---
// Componente de Botones Flotantes (WhatsApp activado al hacer scroll, Volver al inicio solo al final para no logueados)
---

<!-- Left Floating Action: WhatsApp Direct Link -->
<a
  id="whatsapp-floating-btn"
  href="https://wa.me/59177254022"
  target="_blank"
  rel="noopener noreferrer"
  class="fixed bottom-6 left-6 z-40 flex items-center gap-2.5 p-3 sm:px-4 sm:py-3 bg-emerald-600/90 hover:bg-emerald-500 text-white rounded-full shadow-2xl backdrop-blur-md border border-emerald-400/30 transition-all duration-300 opacity-0 pointer-events-none hover:scale-105 group focus:outline-none"
  aria-label="Contactar por WhatsApp"
>
  <svg
    class="w-6 h-6 fill-current text-white flex-shrink-0"
    viewBox="0 0 24 24"
  >
    <path
      d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c-.001 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
    ></path>
  </svg>
</a>

<!-- Right Floating Action: Scroll To Top (Visible ONLY when user has NO active session and reaches near the end of the page) -->
<button
  id="scroll-to-top-btn"
  type="button"
  class="fixed bottom-6 right-6 z-40 flex items-center gap-2 p-3 sm:px-4 sm:py-3 bg-surface/90 hover:bg-accent text-text hover:text-bg rounded-full shadow-2xl backdrop-blur-md border border-white/20 hover:border-accent transition-all duration-300 opacity-0 pointer-events-none hover:scale-105 focus:outline-none"
  aria-label="Volver al inicio"
>
  <span
    class="hidden sm:inline text-xs font-medium uppercase tracking-wider pl-1"
    >Volver arriba</span
  >
  <svg
    class="w-5 h-5"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M4.5 15.75l7.5-7.5 7.5 7.5"></path>
  </svg>
</button>

<script>
  const whatsappBtn = document.getElementById("whatsapp-floating-btn");
  const scrollToTopBtn = document.getElementById("scroll-to-top-btn");

  function checkScrollAndSession() {
    const userJson = localStorage.getItem("connect_user");
    const scrollPosition = window.scrollY;
    const totalHeight = document.documentElement.scrollHeight;
    const windowHeight = window.innerHeight;

    const isMember = Boolean(userJson);

    // 1. WhatsApp Button: Activates after scrolling down a bit (> 250px) ONLY if NOT a logged-in member!
    if (!isMember && scrollPosition > 250) {
      whatsappBtn?.classList.remove("opacity-0", "pointer-events-none");
      whatsappBtn?.classList.add("opacity-100", "pointer-events-auto");
    } else {
      whatsappBtn?.classList.remove("opacity-100", "pointer-events-auto");
      whatsappBtn?.classList.add("opacity-0", "pointer-events-none");
    }

    // 2. Scroll to Top Button: Appears ONLY when reaching near the end of the page AND user is guest
    const isGuest = !userJson;
    const isNearBottom = windowHeight + scrollPosition >= totalHeight - 450;

    if (isGuest && isNearBottom) {
      scrollToTopBtn?.classList.remove("opacity-0", "pointer-events-none");
      scrollToTopBtn?.classList.add("opacity-100", "pointer-events-auto");
    } else {
      scrollToTopBtn?.classList.remove("opacity-100", "pointer-events-auto");
      scrollToTopBtn?.classList.add("opacity-0", "pointer-events-none");
    }
  }

  // Smooth scroll to top click handler
  scrollToTopBtn?.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: "smooth" });
  });

  window.addEventListener("scroll", checkScrollAndSession, { passive: true });
  window.addEventListener("DOMContentLoaded", checkScrollAndSession);
  checkScrollAndSession();
</script>
