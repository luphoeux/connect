---

---

<section
  id="inicio"
  class="relative min-h-screen flex flex-col items-center justify-center overflow-hidden pt-20 sm:pt-24 pb-12 px-4 sm:px-6"
>
  <video
    autoplay
    loop
    muted
    playsinline
    poster="/videos/portada-poster.jpg"
    class="absolute inset-0 w-full h-full object-cover opacity-45 sm:opacity-55 pointer-events-none z-0"
  >
    <source src="/videos/portada-loop.webm" type="video/webm" />
    <source src="/videos/portada-loop.mp4" type="video/mp4" />
  </video>

  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--color-surface-light)_0%,_var(--color-bg)_70%)] opacity-0 pointer-events-none z-0"
  >
  </div>

  <!-- Hero Content Box Centered -->
  <div
    class="relative z-10 text-center w-full max-w-xl lg:max-w-4xl mx-auto flex flex-col items-center justify-center my-auto py-6"
  >
    <h1 class="sr-only">Connect Health &amp; Fitness</h1>

    <!-- Centered Logo -->
    <div class="my-auto flex flex-col items-center justify-center w-full">
      <img
        src="/images/logo_connect_letras.svg"
        alt="Connect Health & Fitness"
        class="mx-auto w-full max-w-xs sm:max-w-md lg:max-w-[820px] h-auto drop-shadow-[0_12px_24px_rgba(0,0,0,0.7)]"
      />

      <div class="h-px w-20 lg:w-32 bg-surface-mid mx-auto my-6 lg:my-8"></div>

      <div class="h-10 sm:h-12 flex items-center justify-center max-w-md sm:max-w-lg lg:max-w-2xl mx-auto mb-8 overflow-hidden">
        <p
          id="hero-rotating-text"
          class="text-sm sm:text-base lg:text-xl font-medium uppercase tracking-[0.25em] text-accent transition-all duration-700 ease-in-out opacity-100 transform translate-y-0 text-center drop-shadow-[0_2px_12px_rgba(230,136,66,0.35)]"
        >
          ENTRENA CON NOSOTROS.
        </p>
      </div>

      <a
        href="/login"
        class="inline-block px-8 py-3.5 sm:px-10 sm:py-4 border border-white/20 text-text uppercase text-xs sm:text-sm tracking-[0.25em] font-medium hover:bg-white/10 transition-colors duration-300"
      >
        Acceder
      </a>
    </div>
  </div>

  <div
    class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce opacity-40"
  >
    <svg
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1"
    >
      <path d="M7 13l5 5 5-5M7 6l5 5 5-5"></path>
    </svg>
  </div>
</section>

<script>
  // Rotating Hero Taglines Every 7 Seconds
  const heroText = document.getElementById("hero-rotating-text");
  const taglines = [
    "ENTRENA CON NOSOTROS.",
    "CONÉCTATE CONTIGO MISMO.",
    "GIMNASIO DE ALTO RENDIMIENTO."
  ];
  let currentIndex = 0;

  if (heroText) {
    setInterval(() => {
      // Fade out & slide slightly down
      heroText.classList.remove("opacity-100", "translate-y-0");
      heroText.classList.add("opacity-0", "translate-y-2");

      setTimeout(() => {
        currentIndex = (currentIndex + 1) % taglines.length;
        heroText.textContent = taglines[currentIndex];
        // Fade in & restore position
        heroText.classList.remove("opacity-0", "translate-y-2");
        heroText.classList.add("opacity-100", "translate-y-0");
      }, 700);
    }, 7000);
  }
</script>
