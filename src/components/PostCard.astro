---
import type { GymPost } from "../lib/facebook";
import { formatRelativeDate } from "../lib/dates";

interface Props {
  post: GymPost;
}

const { post } = Astro.props;
const dateLabel = formatRelativeDate(post.created_time);
const isGradientImage = post.image?.startsWith("linear-gradient(") ?? false;
---

<article class="bg-surface border border-white/5 overflow-hidden">
  <div class="flex items-center gap-4 px-6 pt-6 pb-4">
    <span class="flex items-center justify-center w-11 h-11 rounded-full bg-surface-light text-text-secondary flex-shrink-0 border border-white/10">
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2l9 5v10l-9 5-9-5V7z" />
      </svg>
    </span>
    <div>
      <p class="text-text font-medium text-sm tracking-wide">Connect Health &amp; Fitness</p>
      <p class="text-text-muted text-xs font-light mt-0.5">{dateLabel}</p>
    </div>
  </div>

  {post.image && (
    <div
      class="w-full aspect-[4/3]"
      style={
        isGradientImage
          ? `background: ${post.image};`
          : undefined
      }
    >
      {!isGradientImage && <img src={post.image} alt="" class="w-full h-full object-cover" loading="lazy" />}
    </div>
  )}

  <div class="px-6 py-5">
    <p class="text-text-secondary text-sm font-light leading-relaxed">{post.message}</p>
  </div>

  {post.permalink_url && (
    <div class="px-6 pb-5">
      <a
        href={post.permalink_url}
        target="_blank"
        rel="noopener noreferrer"
        class="text-accent text-xs tracking-[0.2em] uppercase font-medium hover:text-white transition-colors duration-300"
      >
        Ver en Facebook →
      </a>
    </div>
  )}
</article>