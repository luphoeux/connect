---
import { getStories, usesLiveFacebook } from "../lib/facebook";

const stories = await getStories();
const live = usesLiveFacebook();
---

<section class="py-24 px-6 bg-surface-light/20">
  <div class="max-w-5xl mx-auto">
    <div class="flex items-end justify-between mb-10">
      <h2 class="text-3xl md:text-4xl font-light tracking-[0.15em] uppercase">
        Historias
      </h2>
      {live && (
        <span class="text-accent text-xs tracking-[0.3em] uppercase font-medium">
          En vivo
        </span>
      )}
    </div>

    <div class="story-carousel flex gap-5 overflow-x-auto pb-4 snap-x snap-mandatory no-scrollbar">
      {stories.map((story, idx) => (
        <button
          class="story-item snap-start shrink-0 w-36 text-left group cursor-pointer"
          data-index={idx}
          data-id={story.id}
          data-video={story.video || ""}
          data-imagen={story.imagen || ""}
          data-duracion={story.duracion_s ?? ""}
        >
          <div
            class="story-ring relative w-36 aspect-[9/14] rounded-2xl overflow-hidden border-2 border-blue-500 group-hover:border-white/30 transition-colors duration-300 bg-bg p-0.5"
          >
            {story.imagen ? (
              <img
                src={story.imagen}
                alt={story.title}
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            ) : story.video ? (
              <video
                src={story.video}
                muted
                playsinline
                preload="metadata"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            ) : (
              <>
                <div class="absolute inset-0" style={`background: ${story.gradient};`} />
                <div class="absolute inset-0 p-3 flex flex-col justify-between">
                  <span class="flex items-center justify-center w-8 h-8 rounded-full border border-white/40 text-white/80">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 2l9 5v10l-9 5-9-5V7z" />
                    </svg>
                  </span>
                  <span class="text-white text-sm font-light leading-snug">{story.title}</span>
                </div>
              </>
            )}
          </div>
          <span class="block mt-2 text-[11px] text-text-muted tracking-wider uppercase font-light">
            {story.date}{story.duracion_s ? ` · ${story.duracion_s}s` : ""}
          </span>
        </button>
      ))}
    </div>
  </div>
</section>

<script>
  import { openStoryViewer } from "./StoryViewer";
  import { getSeenStories, markStorySeen } from "../lib/seenStories";

  const container = document.querySelector(".story-carousel");
  const seenSet = new Set(getSeenStories());

  const syncSeenRings = () => {
    document.querySelectorAll<HTMLElement>(".story-item").forEach((item) => {
      const id = item.getAttribute("data-id");
      const ring = item.querySelector<HTMLElement>(".story-ring");
      if (!ring) return;
      if (id && seenSet.has(id)) {
        ring.classList.remove("border-blue-500");
        ring.classList.add("border-white/10");
      }
    });
  };

  const reorderQueue = () => {
    if (!container) return;
    const items = Array.from(container.children) as HTMLElement[];
    const checked = new Set<string>();
    items.forEach((item) => {
      const id = item.getAttribute("data-id");
      if (!id || checked.has(id)) return;
      checked.add(id);
      if (seenSet.has(id)) container.appendChild(item);
    });
    syncSeenRings();
  };

  syncSeenRings();
  reorderQueue();

  const items = Array.from(document.querySelectorAll(".story-item"));

  items.forEach((btn) => {
    btn.addEventListener("click", () => {
      const ordered = Array.from(container ? container.children : items) as HTMLElement[];
      const startIdx = Math.max(0, ordered.indexOf(btn));
      const stories = ordered.map((b) => ({
        video: b.getAttribute("data-video") || null,
        imagen: b.getAttribute("data-imagen") || null,
        duracion_s: Number(b.getAttribute("data-duracion")) || null,
      }));
      openStoryViewer(stories, startIdx, (currentIdx) => {
        const current = ordered[currentIdx];
        const currentId = current?.getAttribute("data-id");
        if (currentId) {
          markStorySeen(currentId);
          seenSet.add(currentId);
          const ring = current?.querySelector(".story-ring");
          if (ring) {
            ring.classList.remove("border-blue-500");
            ring.classList.add("border-white/10");
          }
        }
      });
    });
  });
</script>

<style>
  .no-scrollbar {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
</style>