      id="plans-carousel-container"
      class="flex overflow-x-auto snap-x snap-mandatory scrollbar-none gap-4 sm:gap-6 sm:grid sm:grid-cols-2 lg:grid-cols-4 items-stretch pt-4 sm:pt-6 pb-4 sm:pb-2"
    >
      {
        planesData.map((plan) => (
