<section id="horarios" class="py-24 px-4 sm:px-6 max-w-7xl mx-auto space-y-16">
  <!-- Header Banner -->
  <div class="text-center max-w-3xl mx-auto">
    <span class="text-accent text-xs tracking-[0.3em] uppercase font-medium"
      >Connect Health &amp; Fitness</span
