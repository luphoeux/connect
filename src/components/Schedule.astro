    <p class="text-text-muted text-sm sm:text-base font-light leading-relaxed">
      Conoce nuestros horarios de atención, planes de membresía y el cronograma
      de clases del Salón Connect.
    </p>
  </div>

  <!-- General Opening Hours Grid -->
  <div>
    <div class="grid md:grid-cols-3 gap-6">
      {
        horariosGenerales.map(({ dia, hora, nota, days }) => (
          <div
            class="horario-card bg-surface/90 border border-white/10 p-7 backdrop-blur-xl transition-all duration-500 relative overflow-hidden group hover:border-accent hover:bg-accent/15 hover:shadow-[0_0_35px_rgba(230,136,66,0.35)] hover:-translate-y-1 cursor-pointer"
            data-days={days}
