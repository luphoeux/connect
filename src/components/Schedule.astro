        <button
          type="button"
          data-mobile-day="1"
          class="mobile-day-btn flex-1 min-w-[54px] py-2.5 px-2 bg-white/5 border border-white/10 text-center text-xs font-medium uppercase tracking-wider text-text-muted transition-all"
        >
          Lun
