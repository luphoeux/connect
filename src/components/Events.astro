---
const eventos = [
  { titulo: "Desafío de Verano", descripcion: "8 semanas de entrenamiento intensivo. Transforma tu cuerpo.", fecha: "Inscripciones abiertas" },
  { titulo: "Clases Grupales", descripcion: "Spinning, funcional y HIIT todos los días.", fecha: "Consulta horarios" },
];
---

<section id="eventos" class="py-24 px-6 bg-surface-light/30">
  <div class="max-w-5xl mx-auto">
    <h2 class="text-3xl md:text-4xl font-light tracking-[0.15em] uppercase text-center mb-16">
      Eventos &amp; Promociones
    </h2>

    <div class="grid md:grid-cols-2 gap-6">
      {eventos.map(({ titulo, descripcion, fecha }) => (
        <div class="bg-surface border border-white/5 p-8 hover:border-white/10 transition-colors duration-300">
          <span class="text-accent text-xs tracking-[0.3em] uppercase font-medium">{fecha}</span>
          <h3 class="text-xl font-light tracking-[0.08em] mt-4 mb-3">{titulo}</h3>
          <p class="text-text-secondary font-light leading-relaxed text-sm">{descripcion}</p>
        </div>
      ))}
    </div>
  </div>
</section>
